{
 "_comment": "RAD20 concurrency A/B: main vs the burst-armed helper build (power save; queue warm-up is shelved, default off), production Flash-Next layout plus the RAD18 CPU combine in both arms; 1, 2, 4 and 6 concurrent streams (stream_bench, the RAD10 shape: 512-token prompts, 128 tokens), engine /metrics per round. Same environment as rad20-burst-ab.json (rad20-burst-ab.sh sets it). Not used by tests.",
 "schema_version": 1,
 "engine": "radiance",
 "evidence_role": "diagnostic",
 "execution_evidence": "observe",
 "model": "${BC_MODEL_ROOT}/radiance/StillDeadcode/qwen3.8-next-flash-fp8-iq4r-moe/qwen3.8-next-flash-fp8-iq4r-moe.rad",
 "server_args": [],
 "environment": {
  "HIP_VISIBLE_DEVICES": "0",
  "ROCR_VISIBLE_DEVICES": "${R9700_ROCR}"
 },
 "expected_execution": {
  "backend": "ROCm",
  "architectures": [
   "gfx1201"
  ],
  "locators": [
   "${R9700_BDF}"
  ]
 },
 "bench_configs": "mtp-dual",
 "required_metrics": [
  "s1_agg_tps",
  "s1_stream_tps",
  "s2_agg_tps",
  "s2_stream_tps",
  "s4_agg_tps",
  "s4_stream_tps",
  "s6_agg_tps",
  "s6_stream_tps"
 ],
 "repetitions": 1,
 "health_timeout_s": 900,
 "arms": [
  {
   "name": "main",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_MAIN_BIN}",
   "serving": {
    "layout": "flashnext-2xtx-combine",
    "set": {
     "engine.checkpoint_interval": 4096,
     "engine.kv_cache_dtype": "fp8",
     "engine.max_num_batched_tokens": 4096,
     "engine.ngram_placement": "ram",
     "engine.num_speculative_tokens": 3,
     "memory.host_pool_mib": 22528,
     "service.max_context": 32768,
     "service.max_sessions": 6
    },
    "heat": "${BC_WORK_ROOT}/heat/flashnext-mixed.hot-first",
    "histogram": "/dev/null"
   },
   "settings": {}
  },
  {
   "name": "burst",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BURST_BIN}",
   "serving": {
    "layout": "flashnext-2xtx-combine",
    "set": {
     "engine.checkpoint_interval": 4096,
     "engine.kv_cache_dtype": "fp8",
     "engine.max_num_batched_tokens": 4096,
     "engine.ngram_placement": "ram",
     "engine.num_speculative_tokens": 3,
     "memory.host_pool_mib": 22528,
     "service.max_context": 32768,
     "service.max_sessions": 6
    },
    "heat": "${BC_WORK_ROOT}/heat/flashnext-mixed.hot-first",
    "histogram": "/dev/null"
   },
   "settings": {}
  }
 ],
 "stream_bench": {
  "streams": [
   1,
   2,
   4,
   6
  ],
  "prompt_tokens": 512,
  "max_tokens": 128,
  "reps": 2,
  "seed": 1
 }
}
