{
 "_comment": "RAD14 isolation probe with the prefix cache OFF: as qwen35b-engine-isolation.json, to rule out prefix-cache hits (the prompts ran solo first) as the cause of the draft-acceptance drop and the solo-vs-batched divergence.",
 "schema_version": 1,
 "engine": "radiance",
 "evidence_role": "diagnostic",
 "execution_evidence": "observe",
 "model": "${BC_MODEL_ROOT}/radiance/StillDeadcode/qwen3.6-35b-a3b-fp8/qwen3.6-35b-a3b-fp8.rad",
 "server_args": [
  "--radiance-home",
  "${RAD_HOME}",
  "--kernels",
  "libr4d,libr3moe,libref",
  "--placement",
  "expert_tiered",
  "--ngram-placement",
  "ram",
  "--max-num-seqs",
  "6",
  "--max-num-batched-tokens",
  "4096",
  "--checkpoint-interval",
  "4096",
  "--kv-cache-dtype",
  "fp8",
  "--num-speculative-tokens",
  "3",
  "--tp",
  "1",
  "--host-pool-mib",
  "30720",
  "--max-model-len",
  "32768",
  "--no-prefix-cache"
 ],
 "environment": {
  "HIP_VISIBLE_DEVICES": "0",
  "ROCR_VISIBLE_DEVICES": "2",
  "RADIANCE_HOME": "${RAD_HOME}"
 },
 "expected_execution": {
  "backend": "ROCm",
  "architectures": [
   "gfx1201"
  ],
  "locators": [
   "${R9700_BDF}"
  ]
 },
 "bench_configs": "mtp-dual",
 "required_metrics": [
  "iso_solo_repeat_frac",
  "iso_n2_match_frac",
  "iso_n2_prefix_min",
  "iso_n3_match_frac",
  "iso_n3_prefix_min",
  "iso_n4_match_frac",
  "iso_n4_prefix_min",
  "iso_n5_match_frac",
  "iso_n5_prefix_min"
 ],
 "repetitions": 1,
 "health_timeout_s": 900,
 "arms": [
  {
   "name": "eng-a",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BIN}",
   "settings": {}
  },
  {
   "name": "eng-b",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BIN}",
   "settings": {}
  }
 ],
 "stream_bench": {
  "isolation": {
   "prompts": 5,
   "group_sizes": [
    2,
    3,
    4,
    5
   ]
  },
  "prompt_tokens": 512,
  "max_tokens": 128,
  "seed": 1
 }
}