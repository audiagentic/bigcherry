{
 "_comment": "RAD20 Option A: main vs the burst-armed helper build, production Flash-Next layout (engine on the R9700, one helper per XTX; settings mirror launch-flashnext-best.sh plus the RAD18 CPU combine (R3_MOE_WORKER_COMBINE=1, both arms)). Each arm runs its own build: binary, --radiance-home and the helpers (taken from the binary's radiance_home). Set RAD_MAIN_BIN/RAD_MAIN_HOME, RAD_BURST_BIN/RAD_BURST_HOME, R9700_ROCR, XTX_DEVICES and R9700_BDF (rad20-burst-ab.sh does). Not used by tests.",
 "schema_version": 1,
 "engine": "radiance",
 "evidence_role": "diagnostic",
 "execution_evidence": "observe",
 "model": "${BC_MODEL_ROOT}/radiance/StillDeadcode/qwen3.8-next-flash-fp8-iq4r-moe/qwen3.8-next-flash-fp8-iq4r-moe.rad",
 "server_args": [],
 "environment": {
  "HIP_VISIBLE_DEVICES": "0",
  "ROCR_VISIBLE_DEVICES": "${R9700_ROCR}"
 },
 "expected_execution": {
  "backend": "ROCm",
  "architectures": [
   "gfx1201"
  ],
  "locators": [
   "${R9700_BDF}"
  ]
 },
 "bench_configs": "mtp-dual",
 "required_metrics": [
  "pp1024_tps",
  "tg512_tps"
 ],
 "repetitions": 1,
 "health_timeout_s": 900,
 "arms": [
  {
   "name": "main",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_MAIN_BIN}",
   "serving": {
    "layout": "flashnext-2xtx-combine",
    "set": {
     "engine.checkpoint_interval": 4096,
     "engine.kv_cache_dtype": "fp8",
     "engine.max_num_batched_tokens": 4096,
     "engine.ngram_placement": "ram",
     "engine.num_speculative_tokens": 3,
     "memory.host_pool_mib": 22528,
     "service.max_context": 32768,
     "service.max_sessions": 6
    },
    "heat": "${BC_WORK_ROOT}/heat/flashnext-mixed.hot-first",
    "histogram": "/dev/null"
   },
   "settings": {}
  },
  {
   "name": "burst",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BURST_BIN}",
   "serving": {
    "layout": "flashnext-2xtx-combine",
    "set": {
     "engine.checkpoint_interval": 4096,
     "engine.kv_cache_dtype": "fp8",
     "engine.max_num_batched_tokens": 4096,
     "engine.ngram_placement": "ram",
     "engine.num_speculative_tokens": 3,
     "memory.host_pool_mib": 22528,
     "service.max_context": 32768,
     "service.max_sessions": 6
    },
    "heat": "${BC_WORK_ROOT}/heat/flashnext-mixed.hot-first",
    "histogram": "/dev/null"
   },
   "settings": {}
  }
 ]
}
