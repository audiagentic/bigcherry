{
 "_comment": "RAD20 Option A: main vs the burst-armed helper build, production Flash-Next layout (engine on the R9700, one helper per XTX; settings mirror launch-flashnext-best.sh plus the RAD18 CPU combine (R3_MOE_WORKER_COMBINE=1, both arms)). Each arm runs its own build: binary, --radiance-home and the helpers (taken from the binary's radiance_home). Set RAD_MAIN_BIN/RAD_MAIN_HOME, RAD_BURST_BIN/RAD_BURST_HOME, R9700_ROCR, XTX_DEVICES and R9700_BDF (rad20-burst-ab.sh does). Not used by tests.",
 "schema_version": 1,
 "engine": "radiance",
 "evidence_role": "diagnostic",
 "execution_evidence": "observe",
 "model": "${BC_MODEL_ROOT}/radiance/StillDeadcode/qwen3.8-next-flash-fp8-iq4r-moe/qwen3.8-next-flash-fp8-iq4r-moe.rad",
 "server_args": [
  "--kernels",
  "libr4d,libr3moe,libref",
  "--placement",
  "expert_tiered",
  "--ngram-placement",
  "ram",
  "--max-num-seqs",
  "6",
  "--max-num-batched-tokens",
  "4096",
  "--checkpoint-interval",
  "4096",
  "--kv-cache-dtype",
  "fp8",
  "--num-speculative-tokens",
  "3",
  "--tp",
  "1",
  "--host-pool-mib",
  "22528",
  "--max-model-len",
  "32768"
 ],
 "environment": {
  "HIP_VISIBLE_DEVICES": "0",
  "ROCR_VISIBLE_DEVICES": "${R9700_ROCR}",
  "R3_MOE_WORKER_SKIP_OWNED": "1"
 },
 "expected_execution": {
  "backend": "ROCm",
  "architectures": [
   "gfx1201"
  ],
  "locators": [
   "${R9700_BDF}"
  ]
 },
 "bench_configs": "mtp-dual",
 "required_metrics": [
  "pp1024_tps",
  "tg512_tps"
 ],
 "repetitions": 1,
 "health_timeout_s": 900,
 "arms": [
  {
   "name": "main",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_MAIN_BIN}",
   "server_args": [
    "--radiance-home",
    "${RAD_MAIN_HOME}"
   ],
   "environment": {
    "RADIANCE_HOME": "${RAD_MAIN_HOME}"
   },
   "settings": {
    "R3_MOE_WORKER": "1",
    "R3_MOE_WORKER_DEVICES": "${XTX_DEVICES}",
    "R3_MOE_WORKER_MOE_DOWN_TILE": "1",
    "R3_MOE_WORKER_ENGINE_RANKS": "1",
    "R3_MOE_WORKER_MAX_ROWS": "4096",
    "R3_MOE_WORKER_SMALL_ROWS": "8",
    "R3_MOE_WORKER_MIB": "22528",
    "R3_MOE_WORKER_HEAT": "${BC_WORK_ROOT}/runs/perf51/heat.rank0.hot-first",
    "R3_MOE_WORKER_COMBINE": "1"
   }
  },
  {
   "name": "burst",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BURST_BIN}",
   "server_args": [
    "--radiance-home",
    "${RAD_BURST_HOME}"
   ],
   "environment": {
    "RADIANCE_HOME": "${RAD_BURST_HOME}"
   },
   "settings": {
    "R3_MOE_WORKER": "1",
    "R3_MOE_WORKER_DEVICES": "${XTX_DEVICES}",
    "R3_MOE_WORKER_MOE_DOWN_TILE": "1",
    "R3_MOE_WORKER_ENGINE_RANKS": "1",
    "R3_MOE_WORKER_MAX_ROWS": "4096",
    "R3_MOE_WORKER_SMALL_ROWS": "8",
    "R3_MOE_WORKER_MIB": "22528",
    "R3_MOE_WORKER_HEAT": "${BC_WORK_ROOT}/runs/perf51/heat.rank0.hot-first",
    "R3_MOE_WORKER_COMBINE": "1"
   }
  }
 ]
}
