    "R3_MOE_WORKER_ROWS": "0",
    "R3_MOE_WORKER_CAPTURE": "/mnt/data/bigcherry-work/caps-q35-decode",
    "R3_MOE_WORKER_CAPTURE_EVERY": "5",
    "R3_MOE_WORKER_CAPTURE_MAX": "60"
   }
  },
  {
   "name": "q35-engine",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BIN}",
   "settings": {}
  }
 ],
 "stream_bench": {
  "streams": [
   4
  ],
  "prompt_tokens": 512,
  "max_tokens": 128,
  "reps": 2,
  "seed": 1
 }
