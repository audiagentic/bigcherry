{
 "_comment": "RAD14: the 35B with the XTX workers armed to capture decode-sized requests (4 streams, MTP 3) so the worker's decode path can be replayed and its rows-per-expert and kernel times measured on real FP8 decode shapes. The prefix cache stays on: with --no-prefix-cache the engine did not fit its host pool beside the workers. Verify-row counts per step do not depend on it, so the captured request shapes are the same.",
 "schema_version": 1,
 "engine": "radiance",
 "evidence_role": "diagnostic",
 "execution_evidence": "observe",
 "model": "/mnt/data/llm-models/radiance/StillDeadcode/qwen3.6-35b-a3b-fp8/qwen3.6-35b-a3b-fp8.rad",
 "server_args": [
  "--radiance-home",
  "${RAD_HOME}",
  "--kernels",
  "libr4d,libr3moe,libref",
  "--placement",
  "expert_tiered",
  "--ngram-placement",
  "ram",
  "--max-num-seqs",
  "6",
  "--max-num-batched-tokens",
  "4096",
  "--checkpoint-interval",
  "4096",
  "--kv-cache-dtype",
  "fp8",
  "--num-speculative-tokens",
  "3",
  "--tp",
  "1",
  "--host-pool-mib",
  "30720",
  "--max-model-len",
  "32768"
 ],
 "environment": {
  "HIP_VISIBLE_DEVICES": "0",
  "ROCR_VISIBLE_DEVICES": "2",
  "RADIANCE_HOME": "${RAD_HOME}",
  "R3_MOE_WORKER_SKIP_OWNED": "1"
 },
 "expected_execution": {
  "backend": "ROCm",
  "architectures": [
   "gfx1201"
  ],
  "locators": [
   "${R9700_BDF}"
  ]
 },
 "bench_configs": "mtp-dual",
