+def dequant_q8_0(raw: bytes) -> np.ndarray:
+    # BCOP37 (BigCherry): ggml block_q8_0 = f16 scale d + 32 x int8, value = d * q. The unsloth UD quants store the
+    # hyper-connection tensors as Q8_0.
+    b = np.frombuffer(raw, dtype=np.uint8)
+    nb = len(b) // 34
+    blk = b.reshape(nb, 34)
+    d = _f16pair(blk[:, 0:2]).reshape(nb, 1)
+    return (blk[:, 2:34].view(np.int8).astype(np.float32) * d).reshape(-1)
+
