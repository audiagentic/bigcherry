{
 "_comment": "MEN26 step 1: current-pin (radiance 1.14.0, origin/main lab build with the moe-remote-handoff experiment) quality of Flash-Next helper offload against a freshly recorded engine-local reference. Based on tools/lab/radiance/helper-kld.json (MEN11); the helper-on arm is the production three-helper tail layout (devices 0 1 3, budgets 22528/22528/14336 MiB, hottest-first mixed heat, tail placement). REPEAT: reuses the reference recorded by the first capture (capture/), to measure run-to-run spread of the tail metrics. ISOLATE: adds helper-2xtx (the same helpers without the RDNA2 tail card) to separate the tail helper's contribution to the KLD tail.",
 "schema_version": 1,
 "engine": "radiance",
 "evidence_role": "diagnostic",
 "execution_evidence": "observe",
 "quality_only": true,
 "model": "${BC_MODEL_ROOT}/radiance/StillDeadcode/qwen3.8-next-flash-fp8-iq4r-moe/qwen3.8-next-flash-fp8-iq4r-moe.rad",
 "server_args": [],
 "environment": {
  "HIP_VISIBLE_DEVICES": "0",
  "ROCR_VISIBLE_DEVICES": "2",
  "RADIANCE_HOME": "${RAD_HOME}"
 },
 "expected_execution": {
  "backend": "ROCm",
  "architectures": [
   "gfx1201"
  ],
  "locators": [
   "${R9700_BDF}"
  ]
 },
 "quality": {
  "reference_dir": "${KLD_REF_DIR}",
  "control": "helper-off",
  "timeout_s": 5400,
  "args": [
   "--radiance-home",
   "${RAD_HOME}",
   "--kernels",
   "libr4d,libr3moe,libref",
   "--placement",
   "expert_tiered",
   "--tp",
   "1",
   "--host-pool-mib",
   "45056",
   "--kv-cache-dtype",
   "fp8",
   "--max-model-len",
   "8192",
   "--max-num-seqs",
   "1",
   "--max-num-batched-tokens",
   "64"
  ],
  "thresholds": {
   "max_kld_mean_increase": 0.02,
   "max_kld_median_increase": 0.01,
   "max_kld_p99_increase": 0.2,
   "max_kld_p999_increase": 0.5,
   "max_top1_drop_points": 1.0,
   "max_ppl_ratio_increase": 0.05
  }
 },
 "arms": [
  {
   "name": "helper-off",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BIN}",
   "settings": {}
  },
  {
   "name": "helper-2xtx",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BIN}",
   "environment": {
    "R3_MOE_WORKER_SKIP_OWNED": "1"
   },
   "settings": {
    "R3_MOE_WORKER": "1",
    "R3_MOE_WORKER_DEVICES": "0 1",
    "R3_MOE_WORKER_MOE_DOWN_TILE": "1",
    "R3_MOE_WORKER_ENGINE_RANKS": "1",
    "R3_MOE_WORKER_MAX_ROWS": "64",
    "R3_MOE_WORKER_SMALL_ROWS": "8",
    "R3_MOE_WORKER_MIB": "22528",
    "R3_MOE_WORKER_HEAT": "<work-root>/heat/flashnext-mixed.hot-first"
   }
  },
  {
   "name": "helper-on",
   "mode": "stock",
   "shutdown_method": "sigint",
   "binary": "${RAD_BIN}",
   "environment": {
    "R3_MOE_WORKER_SKIP_OWNED": "1"
   },
   "settings": {
    "R3_MOE_WORKER": "1",
    "R3_MOE_WORKER_DEVICES": "0 1 3",
    "R3_MOE_WORKER_MOE_DOWN_TILE": "1",
    "R3_MOE_WORKER_ENGINE_RANKS": "1",
    "R3_MOE_WORKER_MAX_ROWS": "64",
    "R3_MOE_WORKER_SMALL_ROWS": "8",
    "R3_MOE_WORKER_MIB": "22528",
    "R3_MOE_WORKER_HEAT": "<work-root>/heat/flashnext-mixed.hot-first",
    "R3_MOE_WORKER_MIBS": "22528,22528,14336",
    "R3_MOE_WORKER_PLACEMENT": "tail"
   }
  }
 ]
}