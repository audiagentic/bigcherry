+# Ragged IQ8R tail: full prefix and half-height tail use the same ordered prefill body.
+
+@@ find 1
+template <bool I8, int RB = 0, uint32_t SB = kBlock>
+__global__ __launch_bounds__(kPWaves * kWave) R4D_WAVES(6)
+void gemm_8a8_prefill_kernel(const uint8_t* __restrict__ A, const float* __restrict__ Sa,
+                             const uint8_t* __restrict__ W, const uint16_t* __restrict__ Sw,
+                             uint16_t* __restrict__ C, uint32_t M, uint32_t K, uint32_t N,
+                             uint32_t a_ld, uint32_t sa_ld, uint32_t sw_ld) {
+    gemm_8a8_prefill_body<I8, RB, PrefillPlain, false, SB>(A, Sa, W, Sw, C, M, K, N, a_ld, sa_ld,
+                                                          sw_ld, PrefillPlain{});
+}
+@@ replace
+template <bool I8, int RB = 0, uint32_t SB = kBlock>
+__global__ __launch_bounds__(kPWaves * kWave) R4D_WAVES(6)
+void gemm_8a8_prefill_kernel(const uint8_t* __restrict__ A, const float* __restrict__ Sa,
+                             const uint8_t* __restrict__ W, const uint16_t* __restrict__ Sw,
+                             uint16_t* __restrict__ C, uint32_t M, uint32_t K, uint32_t N,
+                             uint32_t a_ld, uint32_t sa_ld, uint32_t sw_ld) {
+    gemm_8a8_prefill_body<I8, RB, PrefillPlain, false, SB>(A, Sa, W, Sw, C, M, K, N, a_ld, sa_ld,
+                                                          sw_ld, PrefillPlain{});
+}
+
+// Only the plain wide-group int8 row uses this wrapper. Full-height symbols stay unchanged.
+constexpr uint32_t kPrefillHalfM = kPBM / 2u;
+constexpr uint32_t kPrefillHalfWaves = kPWW * (kPWA / 2u);
+static_assert(kPWA % 2u == 0u && kPrefillHalfM * 2u == kPrefillHalfWaves * kWave,
+              "half band stages two threads per activation row");
+template <uint32_t SB>
+__global__ __launch_bounds__(kPrefillHalfWaves * kWave) R4D_WAVES(6)
+void gemm_iq8r_prefill_half_kernel(const uint8_t* __restrict__ A, const float* __restrict__ Sa,
+                                  const uint8_t* __restrict__ W, const uint16_t* __restrict__ Sw,
+                                  uint16_t* __restrict__ C, uint32_t M, uint32_t K, uint32_t N,
+                                  uint32_t a_ld, uint32_t sa_ld, uint32_t sw_ld) {
+    gemm_8a8_prefill_body<true, 0, PrefillPlain, false, SB, kPrefillHalfM>(
+        A, Sa, W, Sw, C, M, K, N, a_ld, sa_ld, sw_ld, PrefillPlain{});
+}
+@@ end
+
+@@ find 1
+    const dim3 grid(((uint32_t)M + kPBM - 1) / kPBM, (uint32_t)N / kPBN, 1);
+@@ replace
+    // The tiled row is unchained. Both emits use its original stream, and neither
+    // adds a chain wait/done. The existing eligibility checks above apply to both views:
+    // same K/N and weight planes; N divisible by kPBN keeps the tail C aligned.
+    if constexpr (I8 && RB == 0 && SB == R4D_I8_GROUP_WIDE) {
+        const uint32_t rem = (uint32_t)M % kPBM;
+        const uint32_t prefix = (uint32_t)M - rem;
+        if (prefix && rem && rem <= kPrefillHalfM) {
+            const RadStream s = (RadStream)(uintptr_t)stream;
+            const dim3 prefix_grid(prefix / kPBM, (uint32_t)N / kPBN, 1);
+            const int rc = R4D_EMIT(s, (gemm_8a8_prefill_kernel<I8, RB, SB>), prefix_grid,
+                                   dim3(kPWaves * kWave), 0, (const uint8_t*)a, (const float*)ascale,
+                                   (const uint8_t*)wq, (const uint16_t*)ws, (uint16_t*)c, prefix,
+                                   (uint32_t)K, (uint32_t)N, (uint32_t)a_ld, (uint32_t)sa_ld,
+                                   (uint32_t)sw_ld);
+            if (rc != RAD_OK || hipGetLastError() != hipSuccess) return -6;
+            const dim3 tail_grid(1, (uint32_t)N / kPBN, 1);
+            const int tail_rc = R4D_EMIT(s, (gemm_iq8r_prefill_half_kernel<SB>), tail_grid,
+                                        dim3(kPrefillHalfWaves * kWave), 0,
+                                        (const uint8_t*)a + (size_t)prefix * a_ld,
+                                        (const float*)ascale + (size_t)prefix * sa_ld,
+                                        (const uint8_t*)wq, (const uint16_t*)ws,
+                                        (uint16_t*)c + (size_t)prefix * N, rem,
+                                        (uint32_t)K, (uint32_t)N, (uint32_t)a_ld,
+                                        (uint32_t)sa_ld, (uint32_t)sw_ld);
+            return tail_rc == RAD_OK && hipGetLastError() == hipSuccess ? 0 : -6;
+        }
+    }
+    const dim3 grid(((uint32_t)M + kPBM - 1) / kPBM, (uint32_t)N / kPBN, 1);
+@@ end
