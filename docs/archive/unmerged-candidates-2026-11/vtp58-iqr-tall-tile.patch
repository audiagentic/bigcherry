+
+# Tile geometry as a parameter of the body (default: the shipped 128 weight rows x 128 activation rows), so the fused IQR
+# tile can also run 64 weight rows x 256 activation rows with the same accumulator tiles a wave. These blocks come after
+# the paired ones above on purpose: they anchor on the text those leave behind (the Fused parameter).
+@@ find 1
+constexpr uint32_t kPFK = 64;
+@@ replace
+constexpr uint32_t kPFK = 64;
+// A tile shape: kPWW x kPWA waves, each kPTW weight tiles x kPTA activation tiles of 16 x 16.
+template <uint32_t TW, uint32_t TA, uint32_t WW, uint32_t WA>
+struct PrefillGeometry {
+    static constexpr uint32_t PTW = TW, PTA = TA, PWW = WW, PWA = WA;
+    static constexpr uint32_t BN = WW * TW * 16u, BM = WA * TA * 16u;   // weight x activation rows
+    static constexpr uint32_t waves = WW * WA, units = WW * TW;         // units: 16-row weight tiles a block
+};
+using PrefillGeo128 = PrefillGeometry<kPTW, kPTA, kPWW, kPWA>;
+// Half the weight rows, twice the activation rows: the same tiles a wave, so the same accumulators.
+using PrefillGeoTall = PrefillGeometry<kPTW, kPTA, kPWW / 2u, kPWA * 2u>;
+@@ end
+
+@@ find 1
+template <bool I8, int RB, class Pre, bool ROWF = false, uint32_t SB = kBlock, bool Fused = false>
+@@ replace
+template <bool I8, int RB, class Pre, bool ROWF = false, uint32_t SB = kBlock, bool Fused = false,
+          class Geo = PrefillGeo128>
+@@ end
+
+@@ find 1
+    static_assert(!ROWF || RB == 32, "a row's scale and a block's factor fold as RB 32's one scale");
+@@ replace
+    // This block's tile shape; every name below shadows the shipped geometry's constant of the same name.
+    constexpr uint32_t kPTW = Geo::PTW, kPTA = Geo::PTA, kPWW = Geo::PWW, kPWA = Geo::PWA;
+    constexpr uint32_t kPBN = Geo::BN, kPBM = Geo::BM, kPWaves = Geo::waves;
+    constexpr uint32_t kPrefillLds = 2u * kPBM * (kPFK + 8u);
+    constexpr uint32_t kTPR = kPWaves * kWave / kPBM;   // threads staging one activation row
+    constexpr uint32_t kCH = kPFK / (32u * kTPR);       // 32-byte pieces a thread stages
+    static_assert(kTPR * kCH * 32u == kPFK && kPBM * kTPR == kPWaves * kWave, "whole threads stage whole rows");
+    static_assert(!ROWF || RB == 32, "a row's scale and a block's factor fold as RB 32's one scale");
+@@ end
+
+@@ find 1
+    static_assert(kPBM * 2u == kPWaves * kWave, "two threads stage an activation row");
+@@ replace
+@@ end
+
+@@ find 1
+    const uint32_t sr = tid / 2u, sc = (tid % 2u) * 32u;
+@@ replace
+    const uint32_t sr = tid / kTPR, sc = (tid % kTPR) * kCH * 32u;
+@@ end
+
+@@ find 1
+    Stage8 pa = stage8_load(asrc, true);
+@@ replace
+    Stage8 pa[kCH];
+#pragma unroll
+    for (uint32_t v = 0; v < kCH; ++v) pa[v] = stage8_load(asrc + 32u * v, true);
+@@ end
+
+@@ find 1
+        stage8_store<kPFK>(s_a[half % 2u], sr, sc, pa);
+@@ replace
+#pragma unroll
+        for (uint32_t v = 0; v < kCH; ++v) stage8_store<kPFK>(s_a[half % 2u], sr, sc + 32u * v, pa[v]);
+@@ end
+
+@@ find 1
+        pa = stage8_load(asrc + c1, true);
+@@ replace
+#pragma unroll
+        for (uint32_t v = 0; v < kCH; ++v) pa[v] = stage8_load(asrc + c1 + 32u * v, true);
+@@ end
