+template <class F>
+__global__ __launch_bounds__(kPWaves * kWave) R4D_WAVES(6)
+void iqr_plane_producer(Ctx c, uint8_t* fragp, uint16_t* sc) {
+    using D = Dec<F>;
+    __shared__ __attribute__((aligned(16))) int8_t s_tab[D::kTab];
+    __shared__ __attribute__((aligned(16))) uint8_t s_tr[kPWaves * kTrBytes];
+    const uint32_t tid = threadIdx.x;
+    c.tab = s_tab;
+    D::stage(s_tab, c, tid, kPWaves * kWave);
+    __syncthreads();
+    iqr_decode_partition<F>(c, fragp, sc, blockIdx.x, s_tr + (tid / kWave) * kTrBytes);
+}
