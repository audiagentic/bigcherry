+// One disjoint 16-row partition, in the same fragment and scale order as the legacy hook.
+template <class F>
+__device__ __forceinline__ void iqr_decode_partition(Ctx cc, uint8_t* fragp, uint16_t* sc,
+                                                      uint32_t rt, uint8_t* tr) {
+    using D = Dec<F>;
+    const uint32_t tid = threadIdx.x, lane = tid & (kWave - 1), wave = tid / kWave;
+    const uint32_t ksuper = cc.nkb * 2u;
+    /* A unit's codes are fetched a unit ahead of its decode, so a wave's units do not
+     * each wait out a memory round trip. */
+    typename D::Raw cur = D::fetch(cc, rt, wave, lane, wave < cc.nkb), nxt;
+    for (uint32_t kb = wave; kb < cc.nkb; kb += kPWaves) {
+        if (kb + kPWaves < cc.nkb) nxt = D::fetch(cc, rt, kb + kPWaves, lane, true);
+        uint32_t w[16];
+        D::rows(cur, cc, rb_ratio<F>(cc, rt * 16u + (lane & 15u), kb), w);
+        cur = nxt;
+        D::unzero(cc, rt, kb, w);
+        Stage8 s8[2];
+        frag(w, tr, lane, s8);
+#pragma unroll
+        for (uint32_t h = 0; h < 2; ++h) {
+            uint8_t* d = fragp + ((size_t)rt * ksuper + 2u * kb + h) * kTileBytes +
+                         lane * kLaneBytes;
+            *(uint4*)d = s8[h].v;
+            *(uint4*)(d + 16) = s8[h].w;
+        }
+    }
+    if (sc)
+        for (uint32_t i = tid; i < 16u * cc.nkb; i += kPWaves * kWave) {
+            const uint32_t kb = i / 16u;
+            sc[((size_t)rt * cc.nkb + kb) * 16u + i % 16u] =
+                (uint16_t)fold_scale<F>(cc, rt * 16u + i % 16u, kb);
+        }
+}
