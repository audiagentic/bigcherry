@@ -0,0 +1,175 @@
+"""Device-independent ENG06 scale lane/bits and managed patch mechanics tests.
+
+These tests verify source transformation and equal scale bits, not GPU throughput
+or arithmetic bit identity. Device A/B remains required before PR/merge.
+"""
+from __future__ import annotations
+
+import ast
+import importlib.util
+import re
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+PKG = Path(__file__).resolve().parents[1]
+REPO = PKG.parents[3]
+sys.path.insert(0, str(REPO / "tools"))
+from bigcherry.patcher import FilePatch, apply_all  # noqa: E402
+
+TARGET = "libr4d/r4d_attn_decode_h256_gqa6.hip"
+INITIAL = "r4d_attn_decode_h256_gqa6_hip-6"
+OPT = "r4d_attn_decode_h256_gqa6_hip-6b"
+
+
+def _edits():
+    spec = importlib.util.spec_from_file_location("rad0038_eng06", PKG / "patch.py")
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    edits = {
+        edit.id: edit for patch in module.PATCHES if patch.path == TARGET
+        for edit in patch.edits
+    }
+    return edits[INITIAL], edits[OPT]
+
+
+def _images():
+    """The exact source text of both managed edits, not duplicated fixtures."""
+    tree = ast.parse((PKG / "patch.py").read_text())
+    output = {}
+    for call in ast.walk(tree):
+        if not (isinstance(call, ast.Call) and
+                isinstance(call.func, ast.Name) and call.func.id == "_edit"):
+            continue
+        name = ast.literal_eval(call.args[0])
+        if name in (INITIAL, OPT):
+            output[name] = ast.literal_eval(call.args[1]), ast.literal_eval(call.args[2])
+    assert set(output) == {INITIAL, OPT}
+    return output
+
+
+def _addr(u: int, j: int, k0: int, ctx: int, bs: int,
+          page_table: list[int]):
+    # For TILE=16, kp=lane&7. o/4 is the 32-dimensional scale group.
+    kp, octet = u % 8, u // 8
+    kk = min(k0 + 2 * kp + j, ctx - 1)
+    return page_table[kk // bs], kk % bs, octet // 4
+
+
+def _raw_f16_bits(key):
+    patterns = (0, 0x0400, 0x3c00, 0x7bff, 0x8000, 0xfc00, 0x0001, 0xffff)
+    b, t, g = key
+    return patterns[(b * 7 + t * 11 + g * 3) % len(patterns)]
+
+
+class TestENG06ScaleBroadcast(unittest.TestCase):
+    def test_warp_sources_address_same_scale_bits_with_1_to_4_warps(self):
+        # h256 TILE16: 256 pairs/octets, a full 32-lane wave per active
+        # round; NWARPS=3's final round leaves one whole wave inactive.
+        npi8 = (16 // 2) * (256 // 8)
+        self.assertEqual(npi8, 256)
+        for nw in (1, 2, 3, 4):
+            nthr = nw * 32
+            for bs in (4, 16):  # QSA and ordinary page geometries
+                for ctx in (1, 2, 4, 17, 257, 8192, 49152, 262144):
+                    table = [(b * 17 + 3) % 1031 for b in range((ctx + bs - 1) // bs)]
+                    for k0 in (0, max(0, ctx - 16)):
+                        original_loads = elected_loads = 0
+                        for r in range((npi8 + nthr - 1) // nthr):
+                            for tid in range(nthr):
+                                u = tid + r * nthr
+                                if u >= npi8:
+                                    continue
+                                lane = tid & 31
+                                leader_tid = (tid & ~31) + (lane & 7)
+                                leader_u = leader_tid + r * nthr
+                                self.assertLess(leader_u, npi8)
+                                for j in (0, 1):
+                                    direct = _addr(u, j, k0, ctx, bs, table)
+                                    elected = _addr(leader_u, j, k0, ctx, bs, table)
+                                    self.assertEqual(direct, elected,
+                                                     (nw, bs, ctx, k0, r, tid, j))
+                                    self.assertEqual(_raw_f16_bits(direct),
+                                                     _raw_f16_bits(elected))
+                                    original_loads += 1
+                                    elected_loads += int((lane & 24) == 0)
+                        self.assertEqual(original_loads, 512)
+                        self.assertEqual(elected_loads, 128)
+
+    def test_guarded_path_keeps_original_reader_and_fallback(self):
+        images = _images()
+        first, old_post = images[INITIAL]
+        old, new = images[OPT]
+        original = "vi8s[r][j] = *(const uint16_t*)(base + VISOFF + (o * 8 / VG) * 2);"
+        broadcast = "vi8s[r][j] = __shfl(v_scale_bits, lane & 7, 32);"
+        self.assertIn(old, old_post)
+        self.assertIn(original, old)
+        self.assertIn("if constexpr (TILE == 16 && VG == 32)", new)
+        self.assertIn("if ((lane & 24) == 0)", new)
+        self.assertIn("uint32_t v_scale_bits = 0;", new)
+        self.assertIn(broadcast, new)
+        self.assertEqual(new.count(original), 1, "other group sizes must load directly")
+        self.assertIn("} else {\n                        " + original, new)
+        # No changes to two-token code loads, layout math, dequantiser or LDS
+        # stores: the new edit replaces only the load, leaving all other code
+        # in the original -6 postimage intact.
+        self.assertEqual(old_post.count(old), 1)
+        self.assertNotIn(broadcast, first)
+        self.assertNotIn(broadcast, old_post)
+        replaced = old_post.replace(old, new, 1)
+        self.assertEqual(replaced.count(broadcast), 1)
+        self.assertIn("const h2 s2 = __builtin_bit_cast(h2,", replaced)
+        self.assertIn("(__builtin_bit_cast(h2, lo) - bias) * s2", replaced)
+        self.assertIn("(__builtin_bit_cast(h2, hi) - bias) * s2", replaced)
+        self.assertIn("*(uint32_t*)(dst + b * VSTR)", replaced)
+        self.assertIn("*(uint32_t*)(dst + (4 + b) * VSTR)", replaced)
+
+    def test_fresh_apply_upgrade_idempotence_and_anchor_failures(self):
+        images = _images()
+        raw, legacy = images[INITIAL]
+        old, new = images[OPT]
+        insertion, broadcast = _edits()
+        patch = FilePatch(path=TARGET, language="none",
+                          description="ENG06 incremental scale edit",
+                          edits=(insertion, broadcast))
+        self.assertNotRegex(raw, re.compile(broadcast.guard_pattern()))
+        self.assertNotRegex(legacy, re.compile(broadcast.guard_pattern()))
+        self.assertRegex(new, re.compile(broadcast.guard_pattern()))
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            target = root / TARGET
+            target.parent.mkdir(parents=True)
+            target.write_text(raw)
+            first = apply_all([patch], root)
+            self.assertTrue(all(result.ok for result in first), first)
+            self.assertEqual([e.status for result in first for e in result.results],
+                             ["applied", "applied"])
+            expected = legacy.replace(old, new)
+            self.assertEqual(target.read_text(), expected)
+            second = apply_all([patch], root)
+            self.assertTrue(all(result.ok for result in second), second)
+            self.assertEqual([e.status for result in second for e in result.results],
+                             ["already-applied", "already-applied"])
+            self.assertEqual(target.read_text(), expected)
+
+            # Upgrade a historical already-applied source without duplicating
+            # fetchVi8 and without a permissive guard on its old comment.
+            target.write_text(legacy)
+            upgraded = apply_all([patch], root)
+            self.assertTrue(all(result.ok for result in upgraded), upgraded)
+            self.assertEqual([e.status for result in upgraded for e in result.results],
+                             ["already-applied", "applied"])
+            self.assertEqual(target.read_text(), expected)
+
+            for invalid in (legacy.replace(old, old.replace("vi8s[r][j]", "vs_other[r][j]")),
+                            legacy + old):
+                target.write_text(invalid)
+                result = apply_all([patch], root)
+                self.assertTrue(any(not value.ok for value in result), result)
+                self.assertEqual(target.read_text(), invalid)
+
+
+if __name__ == "__main__":
+    unittest.main()
