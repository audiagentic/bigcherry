+// Immutable HIP kernel probe results, cached for one admitted model/device.
+// Occupancy varies with the K-dependent dynamic LDS reservation, so K (and
+// activation group) is part of the key as well as variant and TOKEN parity.
+// The worker prewarms all combinations at shape setup; forward requests only
+// perform a bounded CPU lookup. No HIP headers are needed to test this.
+class CapabilityCache {
+public:
+    static constexpr std::array<Variant, 9> variants = {{
+        Variant::GenericFp8, Variant::GenericW4, Variant::WideFp8,
+        Variant::H2Fp8R1, Variant::H2Fp8R2, Variant::H2Fp8R4,
+        Variant::W4H2, Variant::MultiRowFp8R4, Variant::Gfx12Fp8R2,
+    }};
+    void clear() { count_ = 0; }
+    bool put(Variant variant, bool token, uint32_t k, uint32_t group,
+             const Capabilities& caps) {
+        for (size_t i = 0; i < count_; ++i)
+            if (same(entries_[i], variant, token, k, group)) {
+                entries_[i].caps = caps;
+                return true;
+            }
+        if (count_ == entries_.size()) return false;
+        entries_[count_++] = Entry{variant, token, k, group, caps};
+        return true;
+    }
+    const Capabilities* find(Variant variant, bool token, uint32_t k,
+                             uint32_t group) const {
+        for (size_t i = 0; i < count_; ++i)
+            if (same(entries_[i], variant, token, k, group))
+                return &entries_[i].caps;
+        return nullptr;
+    }
+    size_t size() const { return count_; }
+
+private:
+    struct Entry {
+        Variant variant{};
+        bool token = false;
+        uint32_t k = 0, group = 0;
+        Capabilities caps{};
+    };
+    static bool same(const Entry& e, Variant v, bool token, uint32_t k, uint32_t group) {
+        return e.variant == v && e.token == token && e.k == k && e.group == group;
+    }
+    // Two stages (hidden and intermediate), both TOKEN parities, all variants.
+    std::array<Entry, 2 * 2 * variants.size()> entries_{};
+    size_t count_ = 0;
+};
+
+inline Choice choose_cached_stage(const CapabilityCache& cache, bool token,
+                                  bool requested, Variant variant, uint32_t k0,
+                                  uint32_t k1, uint32_t group,
+                                  uint32_t block_lds_bytes, bool generic_available) {
+    Capabilities caps{block_lds_bytes, 0u, 0u, 0u, false, generic_available};
+    if (requested) {
+        const auto* saved = cache.find(variant, token, std::max(k0, k1), group);
+        if (saved) {
+            caps = *saved;
+            caps.generic_gemm_available = generic_available;
+        } else if (std::holds_alternative<LdsLayout>(
+                       required_lds_bytes(variant, std::max(k0, k1), group))) {
+            // A valid, unprepared kernel geometry must never silently take
+            // a different fallback or make HIP calls in the request path.
+            return Refuse{Reason::KernelUnavailable};
+        }
+    }
+    return choose_stage(requested, variant, k0, k1, group, caps);
+}
+
 } // namespace r3_moe_gpu::gemv_geometry
