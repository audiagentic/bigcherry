+
+// Cached-vs-uncached oracle: exercise every worker kernel variant, gate/up and
+// down TOKEN parity, row-width pair, group admission, GEMV enablement, generic
+// fallback, device LDS ceiling, kernel availability, and occupancy. The
+// uncached side uses precisely choose_stage with the same synthetic HIP probe
+// fields that the cached side consumed at setup.
+bool same_choice(const Choice& a, const Choice& b) {
+    if (a.index() != b.index()) return false;
+    if (const auto* x = std::get_if<Gemv>(&a)) {
+        const auto& y = std::get<Gemv>(b);
+        return x->variant == y.variant && x->dynamic_lds == y.dynamic_lds;
+    }
+    if (const auto* x = std::get_if<GenericGemm>(&a))
+        return x->gemv_ineligible == std::get<GenericGemm>(b).gemv_ineligible;
+    return std::get<Refuse>(a).reason == std::get<Refuse>(b).reason;
+}
+Capabilities fake_probe(Variant variant, bool token, uint32_t profile, uint32_t k,
+                        bool generic) {
+    const auto geom = required_lds_bytes(variant, k, 128);
+    const auto* layout = std::get_if<LdsLayout>(&geom);
+    const uint32_t block = (profile % 3 == 0) ? 8192 : (profile % 3 == 1) ? 32768 : 65536;
+    const uint32_t dynamic = (profile % 4 == 0) ? block / 2 : block;
+    // gfx12's variant is not a kernel in the worker; it always uses fallback.
+    const bool available = variant != Variant::Gfx12Fp8R2 &&
+                           layout != nullptr && profile % 7 != 0;
+    const uint32_t static_bytes = available ? (token ? 8u : 4u) : 0u;
+    const uint32_t active = available && profile % 5 != 0 ? 2u : 0u;
+    return {block, dynamic, static_bytes, active, available, generic};
+}
+void test_cached_capabilities_full_request_grid() {
+    constexpr std::array<uint32_t, 9> ks = {{0, 127, 128, 256, 2432, 2560, 2688, 3072, 4096}};
+    constexpr std::array<uint32_t, 3> groups = {{64, 128, 256}};
+    size_t comparisons = 0;
+    for (Variant variant : CapabilityCache::variants)
+    for (bool token : {true, false})
+    for (uint32_t k0 : ks)
+    for (uint32_t k1 : ks)
+    for (uint32_t profile = 0; profile < 9; ++profile)
+    for (bool generic : {true, false}) {
+        const uint32_t maxk = std::max(k0, k1);
+        const auto raw = fake_probe(variant, token, profile, maxk, generic);
+        CapabilityCache cached;
+        if (std::holds_alternative<LdsLayout>(required_lds_bytes(variant, maxk, 128))) {
+            CHECK(cached.put(variant, token, maxk, 128, raw));
+            CHECK(cached.size() == 1);
+            CHECK(cached.find(variant, token, maxk, 128) != nullptr);
+        }
+        for (bool requested : {true, false})
+        for (uint32_t group : groups) {
+            Capabilities baseline = raw;
+            // Legacy select_gemv did not query HIP for invalid geometry,
+            // and choose_stage makes geometry refusal before kernel admission.
+            if (group != 128 ||
+                !std::holds_alternative<LdsLayout>(required_lds_bytes(variant, maxk, group)))
+                baseline = {raw.per_block_lds_limit, 0u, 0u, 0u, false, generic};
+            const auto direct = choose_stage(requested, variant, k0, k1, group, baseline);
+            const auto from_cache = choose_cached_stage(cached, token, requested, variant,
+                k0, k1, group, raw.per_block_lds_limit, generic);
+            CHECK(same_choice(direct, from_cache));
+            ++comparisons;
+        }
+        // All lookups/choices above are read-only; no provider or mutation
+        // can occur in per-request selection.
+        CHECK(cached.size() <= 1);
+    }
+    CHECK(comparisons > 100000);
+    CapabilityCache missing;
+    CHECK(std::holds_alternative<Refuse>(choose_cached_stage(
+        missing, true, true, Variant::W4H2, 2560, 2560, 128, 65536, true)));
+    // A model shape change is an explicit rebuild: never reuse stale K.
+    CHECK(missing.put(Variant::W4H2, true, 2560, 128,
+                      fake_probe(Variant::W4H2, true, 1, 2560, true)));
+    CHECK(missing.find(Variant::W4H2, true, 3072, 128) == nullptr);
+    missing.clear();
+    CHECK(missing.size() == 0);
+}
+
+
+void test_preferred_stage_prewarm() {
+    // Mirror Runner's per-model initialisation, including the independent
+    // gate/up versus down K widths, so a request never selects an unwarmed
+    // variant or hits a different grouped-GEMM fallback.
+    for (bool fp8 : {true, false})
+    for (bool w4h2 : {true, false})
+    for (bool multi_row : {true, false})
+    for (uint32_t h2_rows : {0u, 1u, 2u, 4u})
+    for (bool wide : {true, false})
+    for (uint32_t hidden : {128u, 2560u, 3072u, 4096u})
+    for (uint32_t intermediate : {128u, 2560u, 3072u, 4096u})
+    for (bool token : {true, false}) {
+        const Preferences prefs{fp8, w4h2, multi_row, h2_rows, wide};
+        CapabilityCache cache;
+        for (uint32_t k : {hidden, intermediate}) {
+            const auto v = preferred_variant(prefs, k, k);
+            if (cache.find(v, token, k, 128)) continue;
+            CHECK(cache.put(v, token, k, 128, fake_probe(v, token, 4, k, true)));
+        }
+        for (uint32_t k : {hidden, intermediate}) {
+            const auto v = preferred_variant(prefs, k, k);
+            const auto baseline = fake_probe(v, token, 4, k, true);
+            CHECK(same_choice(
+                choose_stage(true, v, k, k, 128, baseline),
+                choose_cached_stage(cache, token, true, v, k, k, 128,
+                                    baseline.per_block_lds_limit, true)));
+        }
+        CHECK(cache.size() <= 2);
+    }
+}
