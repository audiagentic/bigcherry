+    template <bool TOKEN>
+    gemv_geometry::Capabilities query_gemv_capabilities(
+        GemvVariant variant, uint32_t k, uint32_t group) const {
+        using namespace gemv_geometry;
+        Capabilities caps{block_lds_bytes_, 0u, 0u, 0u, false, false};
+        const void* kernel = gemv_function<TOKEN>(variant);
+        const Geometry layout = required_lds_bytes(variant, k, group);
+        if (kernel && std::holds_alternative<LdsLayout>(layout)) {
+            const uint32_t dynamic_bytes = std::get<LdsLayout>(layout).dynamic_bytes;
+            hipFuncAttributes attrs{};
