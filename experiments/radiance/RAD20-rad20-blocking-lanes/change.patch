diff --git a/tools/lab/radiance/rad20-profile.sh b/tools/lab/radiance/rad20-profile.sh
new file mode 100644
index 000000000..4947de65f
--- /dev/null
+++ b/tools/lab/radiance/rad20-profile.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+# RAD20 decode diagnosis: why do the helper's small-lane kernels run ~2x slower with blocking lanes? For each build
+# (polling baseline, RAD20 blocking): start the best layout with helper 0 under rocprofv3 --kernel-trace, sample XTX 0's
+# clocks, send one 512-token decode request, stop. Compares per-kernel device time and clocks between the two.
+# Usage: rad20-profile.sh <polling build plan id> <blocking build plan id> [label]   (directories under $BC_WORK_ROOT/builds)
+#   ARMS="name=<build id|head>[,VAR=value...] ..." replaces the two arms; 'head' builds this checkout first.
+set -u
+POLL=$1 BLOCK=$2 LABEL=${3:-auto} ARMS=${4:-${ARMS:-}} PROF=${5:---kernel-trace --stats}
+set --
+source tools/env/bigcherry-env.sh
+W=${BC_WORK_ROOT}; OUT=$W/runs/rad20-profile-$LABEL-$(date +%m%d%H%M); mkdir -p $OUT
+export ROCM_PATH=/opt/rocm-7.2.4 PATH=/opt/rocm-7.2.4/bin:$PATH
+L=tools/lab/radiance/launch-flashnext-best.sh
+PROMPT='Write a long, detailed story about a lighthouse keeper who discovers a hidden room. Keep going.'
+[ -n "$ARMS" ] || ARMS="polling=$POLL blocking=$BLOCK"
+if [[ " $ARMS" == *"=head"* ]]; then
+    PYTHONPATH=tools timeout 5400 python3 -m bigcherry build --lane radiance-lab:stock:linux-radiance         --experiment moe-remote-handoff > $OUT/build.log 2>&1
+    HEADID=$(grep -oE 'ok build_plan_id=[0-9a-f]+' $OUT/build.log | tail -1 | cut -d= -f2)
+    [ -n "$HEADID" ] || { grep -E ' error:|FAILED' $OUT/build.log | sort -u | head; exit 1; }
+fi
+NAMES=""
+for spec in $ARMS; do
+    name=${spec%%=*}; rest=${spec#*=}; id=${rest%%,*}; [ "$id" = head ] && id=$HEADID
+    vars=""; [[ "$rest" == *,* ]] && vars=$(echo ${rest#*,} | tr , ' ' | tr + ,)
+    NAMES="$NAMES $name"; build=$(ls -d $W/builds/*/$id | head -1)
+    echo "$name: build $id env [$vars]" | tee -a $OUT/summary.txt
+    env $vars HELPER0_WRAP="rocprofv3 $PROF --output-format csv -d $OUT/$name-prof --" \
+        bash $L start --build $build > $OUT/$name-launch.log 2>&1 || { tail $OUT/$name-launch.log; bash $L stop; continue; }
+    # one warm-up, then the measured decode with clocks sampled (1 s) on XTX 0
+    curl -s http://127.0.0.1:36080/v1/completions -d "{\"prompt\":\"$PROMPT\",\"max_tokens\":64}" > /dev/null
+    # XTX 0's current sclk/mclk levels from sysfs every 10 ms (the first card whose pp_dpm_mclk tops out at 1249 MHz)
+    CARD=$(grep -l '1249Mhz' /sys/class/drm/card*/device/pp_dpm_mclk | head -1 | xargs dirname)
+    ( while :; do echo "mclk $(grep '\*' $CARD/pp_dpm_mclk) sclk $(grep '\*' $CARD/pp_dpm_sclk)"; sleep 0.01; done ) > $OUT/$name-clocks.txt &
+    CL=$!
+    t0=$(date +%s.%N)
+    curl -s http://127.0.0.1:36080/v1/completions -d "{\"prompt\":\"$PROMPT\",\"max_tokens\":512,\"temperature\":0}" > $OUT/$name-reply.json
+    t1=$(date +%s.%N)
+    kill $CL 2>/dev/null
+    python3 -c "import json,sys;r=json.load(open('$OUT/$name-reply.json'));n=r['usage']['completion_tokens'];print('$name', n, 'tokens', round(n/($t1-$t0),1), 'tok/s (incl prefill)')" | tee -a $OUT/summary.txt
+    bash $L stop > /dev/null 2>&1
+    cp $W/flashnext/helper0-*.log $OUT/ 2>/dev/null; rm -f $W/flashnext/helper*-*.log $W/flashnext/engine-*.log
+done
+for name in $NAMES; do
+    s=$(find $OUT/$name-prof -name '*kernel_stats.csv' | head -1)
+    echo "== $name: top kernels (calls, total ms, avg us)" | tee -a $OUT/summary.txt
+    [ -n "$s" ] && python3 - "$s" <<'PY' | tee -a $OUT/summary.txt
+import csv, sys
+rows = list(csv.DictReader(open(sys.argv[1])))
+rows.sort(key=lambda r: -float(r["TotalDurationNs"]))
+for r in rows[:10]:
+    print(f'{r["Calls"]:>8} {float(r["TotalDurationNs"])/1e6:9.1f} ms {float(r["AverageNs"])/1e3:8.1f} us  {r["Name"][:90]}')
+PY
+    echo "-- XTX 0 clock levels during the decode (10 ms samples: count, mclk, sclk)" | tee -a $OUT/summary.txt
+    sed -E 's/ +/ /g' $OUT/$name-clocks.txt | sort | uniq -c | sort -rn | head -8 | tee -a $OUT/summary.txt
+done
+echo "OUT $OUT"; echo RAD20_PROFILE_DONE
diff --git a/tools/lab/radiance/rad20-rad18-e2e.sh b/tools/lab/radiance/rad20-rad18-e2e.sh
new file mode 100644
index 000000000..cbadc2207
--- /dev/null
+++ b/tools/lab/radiance/rad20-rad18-e2e.sh
@@ -0,0 +1,61 @@
+#!/bin/bash
+# RAD20 + RAD18 in one build-server session (run through `bigcherry slice lab feat/rad20-blocking-lanes ...`):
+#   1. build this slice (RAD20: blocking helper lanes) and its parent commit (main: the RAD18 combine binary and
+#      RAD20's baseline arm), both --experiment moe-remote-handoff; no build runs during the measurements below;
+#   2. RAD20 A/B, helper-rad20-ab.json (polling vs blocking), with pidstat sampling every helper thread's CPU;
+#   3. RAD18 on the main build: helper-combine-ab.json (combine off/on) and helper-combine-nofire-ab.json (off vs
+#      on-but-never-fires), for the tg128 check; every cell now records MTP draft totals (cell.json "draft").
+# Usage: rad20-rad18-e2e.sh [pairs=4]
+set -u
+PAIRS=${1:-4}
+W=${BC_WORK_ROOT}
+OUT=$W/runs/rad20-rad18-$(date +%m%d%H%M)
+mkdir -p $OUT
+export ROCM_PATH=/opt/rocm-7.2.4 PATH=/opt/rocm-7.2.4/bin:$PATH
+git fetch -q origin main
+HEAD=$(git rev-parse HEAD); BASE=$(git merge-base HEAD FETCH_HEAD)
+echo "slice $HEAD baseline $BASE" | tee $OUT/builds.txt
+
+build() {   # $1 label: builds the checked-out tree, prints its runtime prefix
+    PYTHONPATH=tools timeout 5400 python3 -m bigcherry build --lane radiance-lab:stock:linux-radiance \
+        --experiment moe-remote-handoff > $OUT/build-$1.log 2>&1
+    local plan; plan=$(grep -oE 'ok build_plan_id=[0-9a-f]+' $OUT/build-$1.log | tail -1 | cut -d= -f2)
+    [ -n "$plan" ] || { grep -E ' error:|FAILED' $OUT/build-$1.log | sort -u | head >&2; return 1; }
+    ls -d $W/builds/*/$plan
+}
+NEW=$(build new) || { echo "RAD20 build failed"; exit 1; }
+git checkout -q --detach $BASE
+OLD=$(build base); rc=$?
+git checkout -q --detach $HEAD
+[ $rc -eq 0 ] || { echo "baseline build failed"; exit 1; }
+for p in $NEW $OLD; do echo "$p $(sha256sum $p/radiance_home/helpers/r3_moe_worker | cut -c1-16)"; done | tee -a $OUT/builds.txt
+
+export RAD_BIN_NEW=$NEW/bin/radiance RAD_BIN_BASE=$OLD/bin/radiance RAD_BIN=$OLD/bin/radiance \
+       RAD_HOME=$OLD/radiance_home R9700_BDF=0000:09:00.0
+
+ab() {   # $1 config, $2 output name
+    PYTHONPATH=tools timeout 14400 python3 -m bigcherry ab-benchmark --server-config tools/lab/radiance/$1 \
+        --output $OUT/$2 --pairs $PAIRS --settle-seconds 20 > $OUT/$2.log 2>&1
+    tail -2 $OUT/$2.log
+    for d in $OUT/$2/pair-*; do
+        python3 - "$d/cell.json" <<'PY'
+import json, sys
+c = json.load(open(sys.argv[1])); m = c.get("metrics") or {}; dr = c.get("draft") or {}
+acc = f"{dr['accepted']}/{dr['drafted']}" if dr.get("drafted") else "-"
+print(sys.argv[1].split("/")[-2], c.get("position"), " ".join(f"{k}={m[k]:.1f}" for k in sorted(m) if k.endswith("_tps")),
+      "draft", acc, c.get("metric_error", ""))
+PY
+    done
+}
+
+# 2. RAD20, with every r3_moe_worker thread's CPU sampled (pidstat -t, 5 s) for the whole run; cells run in the order
+#    ab.log lists, so the n-th pair of helper PIDs is the n-th cell.
+pidstat -t -h -u -C r3_moe_worker 5 > $OUT/rad20-pidstat.txt 2>&1 &
+PS=$!
+echo "== RAD20 polling vs blocking"; ab helper-rad20-ab.json rad20
+kill $PS 2>/dev/null; wait $PS 2>/dev/null
+# 3. RAD18 on the main build
+echo "== RAD18 combine off/on";            ab helper-combine-ab.json rad18-combine
+echo "== RAD18 combine off/never-fires";   ab helper-combine-nofire-ab.json rad18-nofire
+echo "OUT $OUT"
+echo RAD20_RAD18_DONE
diff --git a/tools/lab/radiance/wait-interference-bench.hip b/tools/lab/radiance/wait-interference-bench.hip
new file mode 100644
index 000000000..bff806901
--- /dev/null
+++ b/tools/lab/radiance/wait-interference-bench.hip
@@ -0,0 +1,97 @@
+// RAD20: does a wait armed on a second, idle stream slow kernels on the active stream? In the live helper, one idle
+// lane stream holding an unsatisfied hipStreamWaitValue32 made the active lane's decode GEMV 2.2x slower (64 -> 134 us)
+// with no overlapping kernel in the trace. Stream A runs a weight-streaming kernel back to back, timed on the GPU clock;
+// stream B is idle, or holds an armed hipStreamWaitValue32 on a host-mapped word, or holds our own one-wave wait kernel
+// (s_sleep loop on the same word). The word is released at the end so every stream drains.
+// Build: hipcc -O3 --offload-arch=gfx1100 wait-interference-bench.hip -o wait-interference-bench
+// Run:   HIP_VISIBLE_DEVICES=<xtx> GPU_MAX_HW_QUEUES=8 ./wait-interference-bench [MiB a kernel=16] [kernels=2000] [gated_us=0]
+// gated_us > 0: like a live lane, stream A pre-queues a hipStreamWaitValue32 before every kernel (4 ahead) and a host
+// thread releases one request every gated_us.
+#include <hip/hip_runtime.h>
+#include <algorithm>
+#include <chrono>
+#include <thread>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#define CK(x) do { hipError_t e_ = (x); if (e_ != hipSuccess) { std::fprintf(stderr, "%s: %s\n", #x, hipGetErrorString(e_)); std::exit(1); } } while (0)
+
+__global__ void stream_read(const uint4* w, size_t n, unsigned long long* st, float* sink) {
+    __shared__ unsigned long long t0;
+    if (threadIdx.x == 0) t0 = wall_clock64();
+    __syncthreads();
+    float acc = 0.f;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < n; i += (size_t)gridDim.x * blockDim.x) {
+        const uint4 v = w[i];
+        acc += __uint_as_float(v.x) + __uint_as_float(v.w);
+    }
+    if (acc == 1234.5f) *sink = acc;
+    __syncthreads();
+    if (threadIdx.x == 0) { atomicMin(&st[0], t0); atomicMax(&st[1], wall_clock64()); }
+}
+
+/* One wave waits for the word to reach `want`, sleeping between system-scope loads. */
+__global__ void sleep_wait(const uint32_t* word, uint32_t want) {
+    if (threadIdx.x) return;
+    while (__hip_atomic_load(word, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM) < want) __builtin_amdgcn_s_sleep(127);
+}
+
+int main(int argc, char** argv) {
+    const size_t mib = argc > 1 ? std::strtoul(argv[1], nullptr, 10) : 16;
+    const int kernels = argc > 2 ? std::atoi(argv[2]) : 2000;
+    const int gated_us = argc > 3 ? std::atoi(argv[3]) : 0;
+    CK(hipSetDevice(0));
+    int khz = 0; CK(hipDeviceGetAttribute(&khz, hipDeviceAttributeWallClockRate, 0));
+    const size_t sets = 16, n = mib * 1024 * 1024 / sizeof(uint4);
+    uint4* w; float* sink; unsigned long long* st;
+    CK(hipMalloc(&w, n * sizeof(uint4) * sets)); CK(hipMemset(w, 1, n * sizeof(uint4) * sets));
+    CK(hipMalloc(&sink, 4)); CK(hipMalloc(&st, 16 * kernels));
+    uint32_t* word; uint32_t* word_dev;
+    CK(hipHostMalloc(&word, 64, hipHostMallocMapped | hipHostMallocPortable));
+    CK(hipHostGetDevicePointer((void**)&word_dev, word, 0));
+    uint32_t* req = word + 8;            /* stream A's request word (gated mode), another cache line */
+    uint32_t* req_dev = word_dev + 8;
+    hipStream_t a, b;
+    CK(hipStreamCreateWithFlags(&a, hipStreamNonBlocking));
+    CK(hipStreamCreateWithFlags(&b, hipStreamNonBlocking));
+    const char* names[] = {"stream B idle", "stream B: armed hipStreamWaitValue32", "stream B: armed s_sleep wait kernel",
+                           "stream B: 4 armed hipStreamWaitValue32", "stream B: 4 armed s_sleep wait kernels"};
+    /* argv[4]: the modes to run, in order (digits 0-4); the slowdown has been seen to persist once triggered. */
+    const char* order = argc > 4 ? argv[4] : "01230123";
+    for (const char* o = order; *o; ++o) {
+            const int mode = *o - '0';
+            if (mode < 0 || mode > 4) continue;
+            *word = 0;
+            if (mode == 1) CK(hipStreamWaitValue32(b, word_dev, 1, hipStreamWaitValueGte, 0xffffffffu));
+            if (mode == 2) hipLaunchKernelGGL(sleep_wait, dim3(1), dim3(64), 0, b, word_dev, 1u);
+            if (mode == 3) for (uint32_t k = 1; k <= 4; ++k) CK(hipStreamWaitValue32(b, word_dev, k, hipStreamWaitValueGte, 0xffffffffu));
+            if (mode == 4) for (uint32_t k = 1; k <= 4; ++k) hipLaunchKernelGGL(sleep_wait, dim3(1), dim3(64), 0, b, word_dev, k);
+            std::vector<unsigned long long> init(2 * kernels);
+            for (int i = 0; i < kernels; ++i) { init[2 * i] = ~0ull; init[2 * i + 1] = 0; }
+            CK(hipMemcpyAsync(st, init.data(), 16 * kernels, hipMemcpyHostToDevice, a));
+            __atomic_store_n(req, 0u, __ATOMIC_RELEASE);
+            std::thread releaser;
+            if (gated_us > 0)
+                releaser = std::thread([&] {   /* the engine: one request every gated_us */
+                    for (int i = 1; i <= kernels; ++i) {
+                        std::this_thread::sleep_for(std::chrono::microseconds(gated_us));
+                        __atomic_store_n(req, (uint32_t)i, __ATOMIC_RELEASE);
+                    }
+                });
+            for (int i = 0; i < kernels; ++i) {
+                if (gated_us > 0) CK(hipStreamWaitValue32(a, req_dev, (uint32_t)(i + 1), hipStreamWaitValueGte, 0xffffffffu));
+                hipLaunchKernelGGL(stream_read, dim3(192), dim3(256), 0, a, w + (i % sets) * n, n, st + 2 * i, sink);
+            }
+            CK(hipStreamSynchronize(a));
+            if (releaser.joinable()) releaser.join();
+            __atomic_store_n(word, 8u, __ATOMIC_RELEASE);   // release stream B's wait
+            CK(hipStreamSynchronize(b));
+            std::vector<unsigned long long> v(2 * kernels);
+            CK(hipMemcpy(v.data(), st, 16 * kernels, hipMemcpyDeviceToHost));
+            std::vector<double> d;
+            for (int i = 100; i < kernels; ++i) d.push_back((v[2 * i + 1] - v[2 * i]) * 1000.0 / khz);
+            std::sort(d.begin(), d.end());
+            std::printf("%-44s kernel p50 %7.1f us p90 %7.1f us\n", names[mode], d[d.size() / 2], d[d.size() * 9 / 10]);
+        }
+    return 0;
+}
