+/* RAD46 pair-DPP experiment: two adjacent lanes own one output column.
+ * Each lane computes two dot16 partials in a K64 group. The even lane folds
+ * its p0+p1, then the odd lane's p2 and p3, preserving the validated order.
+ * Both lanes remain active DPP sources, including padded rows. Dot8 resets
+ * and the weighted K128 scale fold are unchanged from output-lane/quad-DPP.
+ * Host dispatch admits only complete K128 groups and complete N64 tiles. */
+constexpr uint32_t kPairDppN = 64, kPairDppRB = 12;
+template <bool TOKEN, uint32_t RB>
+__global__ __launch_bounds__(128) void lane_moe_rows_w4_pairdpp(
+    const uint8_t* aq, const float* as, const int32_t* sorted, const int32_t* off, uint32_t top_k,
+    void* const* code0, void* const* scale0, void* const* code1, void* const* scale1,
+    uint32_t n0, uint32_t n1, uint32_t k0, uint32_t k1, uint32_t a_stride, uint32_t out_stride,
+    uint16_t* out, uint32_t part_pitch) {
+#pragma clang fp contract(off)
+#pragma clang fp reassociate(off)
+    static_assert(RB > 0 && RB <= 16, "pair-DPP row batch exceeds staging geometry");
+    const uint32_t e = blockIdx.x, tid = threadIdx.x, qlane = tid & 1u;
+    const uint32_t rs = (uint32_t)off[e], re = (uint32_t)off[e + 1];
+    if (rs >= re) return;
+    const uint32_t cls = e & 1u, ix = e >> 1;
+    const uint32_t N = cls ? n1 : n0, K = cls ? k1 : k0;
+    const uint32_t n_base = blockIdx.y * kPairDppN, n = n_base + tid / 2u;
+    if (n_base >= N) return;
+    const uint8_t* codes = static_cast<const uint8_t*>(cls ? code1[ix] : code0[ix]);
+    const uint8_t* scales = static_cast<const uint8_t*>(cls ? scale1[ix] : scale0[ix]);
+    if (!codes || !scales) return;
+    __shared__ uint4 activation[2][RB][16];
+    __shared__ float activation_scale[2][RB];
+    __shared__ uint32_t arow[RB];
+    // Same integer conversion used by libr3/r3_mxfp4_gemv.h. Every E4M3
+    // byte, including subnormals and signed zero, maps to exact half bits.
+    auto to_half = [](uint32_t code) {
+        const uint32_t mag = code & 0x7fu;
+        const uint64_t sub = (mag & 4u) ? 0x2300220021002000ull : 0x1e001c0018000000ull;
+        const uint32_t subnormal = (uint32_t)(sub >> ((mag & 3u) * 16u)) & 0xffffu;
+        return ((code & 0x80u) << 8) | (mag < 8u ? subnormal : (mag << 7) + (8u << 10));
+    };
+    auto decode = [](uint32_t w) {
+        // Magnitudes 1.125,3.25,5.5,8,11,14,18,22 have half bits
+        // 3c80,4280,4580,4800,4980,4b00,4c80,4d80. Register byte
+        // tables avoid eight LDS lookups per packed word. Unlike MXFP4's
+        // interleaved layout, low nibbles here are K0..3, high are K4..7.
+        const uint32_t ev = w & 0x0f0f0f0fu, od = (w >> 4) & 0x0f0f0f0fu;
+        const uint32_t ei = ev & 0x07070707u, oi = od & 0x07070707u;
+        const uint32_t e_lo = __builtin_amdgcn_perm(0x80800080u, 0x00808080u, ei);
+        const uint32_t e_hi = __builtin_amdgcn_perm(0x4d4c4b49u, 0x4845423cu, ei) | ((ev & 0x08080808u) << 4);
+        const uint32_t o_lo = __builtin_amdgcn_perm(0x80800080u, 0x00808080u, oi);
+        const uint32_t o_hi = __builtin_amdgcn_perm(0x4d4c4b49u, 0x4845423cu, oi) | ((od & 0x08080808u) << 4);
+        return make_uint4(__builtin_amdgcn_perm(e_hi, e_lo, 0x05010400u),
+                          __builtin_amdgcn_perm(e_hi, e_lo, 0x07030602u),
+                          __builtin_amdgcn_perm(o_hi, o_lo, 0x05010400u),
+                          __builtin_amdgcn_perm(o_hi, o_lo, 0x07030602u));
+    };
+    auto dot8 = [](uint4 x, uint4 w) {
+        float s = 0.0f;
+        asm("v_dot2_f32_f16 %0, %1, %2, %0" : "+v"(s) : "v"(x.x), "v"(w.x));
+        asm("v_dot2_f32_f16 %0, %1, %2, %0" : "+v"(s) : "v"(x.y), "v"(w.y));
+        asm("v_dot2_f32_f16 %0, %1, %2, %0" : "+v"(s) : "v"(x.z), "v"(w.z));
+        asm("v_dot2_f32_f16 %0, %1, %2, %0" : "+v"(s) : "v"(x.w), "v"(w.w));
+        return s;
+    };
+    auto pair_sum = [](float first, float second) {
+        // Even lane owns p0,p1; odd lane owns p2,p3. Retain the ordered
+        // ((p0+p1)+p2)+p3 sum. DPP src0 commutation is exact for finite
+        // unscaled dot16 partials. Both input registers survive all reads.
+        float sum;
+        asm("v_add_f32 %0, %1, %2\n\t"
+            "v_add_f32_dpp %0, %1, %0 quad_perm:[1,1,3,3] row_mask:0xf bank_mask:0xf\n\t"
+            "v_add_f32_dpp %0, %2, %0 quad_perm:[1,1,3,3] row_mask:0xf bank_mask:0xf"
+            : "=&v"(sum) : "v"(first), "v"(second));
+        return sum;
+    };
+    for (uint32_t r0 = rs; r0 < re; r0 += RB) {
+        const uint32_t nr = re - r0 < RB ? re - r0 : RB;
+        if (tid < RB)
+            arow[tid] = tid < nr ? (TOKEN ? (uint32_t)sorted[r0 + tid] / top_k : r0 + tid) : 0u;
+        float acc[RB];
+#pragma unroll
+        for (uint32_t r = 0; r < RB; ++r) acc[r] = 0.0f;
+        uint4 prefetched[2];
+        uint16_t prefetched_scales;
+        auto fetch = [&](uint32_t kc) {
+#pragma unroll
+            for (uint32_t group = 0; group < 2; ++group)
+                prefetched[group] = *reinterpret_cast<const uint4*>(
+                    codes + (uint64_t)n * (K / 2u) + kc / 2u + group * 32u + qlane * 16u);
+            prefetched_scales = reinterpret_cast<const uint16_t*>(
+                scales + (uint64_t)n * (K / 64u))[kc / 128u];
+        };
+        auto stage = [&](uint32_t kc, uint32_t buf) {
+            if (tid < RB)
+                activation_scale[buf][tid] = tid < nr ?
+                    as[(uint64_t)arow[tid] * (a_stride / 128u) + kc / 128u] : 0.0f;
+            for (uint32_t i = tid; i < RB * 8u; i += 128u) {
+                const uint32_t r = i / 8u, p16 = i % 8u;
+                // Zero every invalid row, so the hot arithmetic has no row predicates.
+                const uint4 q = r < nr ? *reinterpret_cast<const uint4*>(
+                    aq + (uint64_t)arow[r] * a_stride + kc + p16 * 16u) : make_uint4(0, 0, 0, 0);
+                const uint32_t qw[4] = {q.x, q.y, q.z, q.w};
+                uint32_t hw[8];
+#pragma unroll
+                for (uint32_t j = 0; j < 4; ++j) {
+                    hw[2 * j] = to_half(qw[j] & 255u) | (to_half((qw[j] >> 8) & 255u) << 16);
+                    hw[2 * j + 1] = to_half((qw[j] >> 16) & 255u) | (to_half(qw[j] >> 24) << 16);
+                }
+                activation[buf][r][2 * p16] = make_uint4(hw[0], hw[1], hw[2], hw[3]);
+                activation[buf][r][2 * p16 + 1] = make_uint4(hw[4], hw[5], hw[6], hw[7]);
+            }
+        };
+        fetch(0);
+        __syncthreads();
+        stage(0, 0);
+        __syncthreads();
+        uint32_t cur = 0;
+        for (uint32_t kc = 0; kc < K; kc += 128u, cur ^= 1u) {
+            const uint4 current[2] = {prefetched[0], prefetched[1]};
+            const uint16_t ws = prefetched_scales;
+            const float ws0 = gemv_e4m3(ws & 255u) * 0x1p-13f;
+            const float ws1 = gemv_e4m3(ws >> 8) * 0x1p-13f;
+            if (kc + 128u < K) fetch(kc + 128u);
+            float first_weighted[RB];
+#pragma unroll
+            for (uint32_t group = 0; group < 2; ++group) {
+                const uint4 w0 = decode(current[group].x), w1 = decode(current[group].y);
+                const uint4 w2 = decode(current[group].z), w3 = decode(current[group].w);
+                const uint32_t kw = group * 8u + qlane * 4u;
