+ * padding. An all-zero, infinite or NaN row keeps e = 0 (fp16 carries inf and NaN). */
+constexpr uint32_t kReduceBlock = 256;
+__device__ inline void lane_write_result_row(const float* vals, uint32_t hidden, uint16_t* out) {
+    __shared__ float red[kReduceBlock];
