diff --git a/tools/lab/radiance/combine-cpu-bench.cpp b/tools/lab/radiance/combine-cpu-bench.cpp
new file mode 100644
index 000000000..5cbeb125a
--- /dev/null
+++ b/tools/lab/radiance/combine-cpu-bench.cpp
@@ -0,0 +1,57 @@
+// RAD23: helper 0's CPU combine (worker_combine.h CombinePool + combine_f16.h), timed without a model. Planes are the
+// helpers' f32 per-token partials (protocol 20), the output one fp16 row a token, all in page-aligned memory shaped like a
+// real large-lane step; a mask marks which helper wrote each row (density per helper is a parameter: the tail helper owns
+// few routes). Prints microseconds a step for 2..4 helpers and 1..N threads.
+// Build: g++ -O3 -std=c++20 -mavx2 -mf16c -pthread -I engines/radiance/components/moe-remote tools/lab/radiance/combine-cpu-bench.cpp -o combine-cpu-bench
+// Run:   ./combine-cpu-bench [rows=2048] [tail_density=0.05]
+#include <atomic>
+#include <chrono>
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <thread>
+#include <vector>
+#include "moe_remote_shm.h"
+namespace { inline bool stopping() { return false; } }  // worker_container.h supplies this in the worker
+#include "worker_combine.h"
+
+int main(int argc, char** argv) {
+    const uint32_t rows = argc > 1 ? (uint32_t)std::atoi(argv[1]) : 2048u, hidden = 2560u;
+    const double tail = argc > 2 ? std::atof(argv[2]) : 0.05;
+    if (!combine_cpu_supported()) { std::printf("needs AVX2 and F16C\n"); return 1; }
+    std::mt19937 rng(7);
+    std::uniform_real_distribution<float> val(-2.0f, 2.0f);
+    // kSets copies of every plane, used in turn, so a step reads memory the last few steps did not touch (well past the
+    // 25 MiB L3), the way the helpers' DMA-written planes arrive.
+    constexpr int kSets = 6;
+    std::vector<std::vector<float>> plane(4 * kSets, std::vector<float>((size_t)rows * hidden));
+    for (auto& p : plane) for (auto& v : p) v = val(rng);
+    std::vector<std::vector<uint16_t>> out(kSets, std::vector<uint16_t>((size_t)rows * hidden));
+    for (uint32_t helpers = 2; helpers <= 4; ++helpers) {
+        // the heads (XTX) write nearly every row; the last helper is the tail and writes `tail` of them
+        std::vector<uint8_t> mask(rows, 0);
+        std::bernoulli_distribution head(0.97), tl(tail);
+        for (uint32_t t = 0; t < rows; ++t)
+            for (uint32_t k = 0; k < helpers; ++k)
+                if ((k + 1 < helpers || helpers == 2) ? head(rng) : tl(rng)) mask[t] |= (uint8_t)(1u << k);
+        auto step = [&](CombinePool& pool, int i) {
+            const int k = i % kSets;
+            const float* src[4] = {plane[4 * k].data(), plane[4 * k + 1].data(), plane[4 * k + 2].data(), plane[4 * k + 3].data()};
+            pool.combine(src, helpers, out[k].data(), mask.data(), rows, hidden);
+        };
+        for (uint32_t threads : {1u, 2u, 4u, 8u, 12u, 16u}) {
+            CombinePool pool(threads);
+            for (int w = 0; w < kSets; ++w) step(pool, w);
+            const int it = 30;
+            const auto t0 = std::chrono::steady_clock::now();
+            for (int i = 0; i < it; ++i) step(pool, i);
+            const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count() / it;
+            uint64_t rd = 0;   // bytes the step must move: every present helper row read, every touched row written
+            for (uint32_t t = 0; t < rows; ++t) { rd += 4ull * hidden * __builtin_popcount(mask[t]); if (mask[t]) rd += 2ull * hidden; }
+            std::printf("helpers %u threads %2u: %7.1f us a step (%.1f GB/s moved)\n", helpers, threads, us, rd / (us * 1e3));
+            std::fflush(stdout);
+        }
+    }
+}
