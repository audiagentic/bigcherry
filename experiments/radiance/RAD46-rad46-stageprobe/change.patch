+                r.expert < 0 || (uint32_t)r.expert >= experts()) return false;
+            const size_t flat = (size_t)r.token * topk + r.slot;
+            if (route_at[flat] >= 0) return false;
+            route_at[flat] = (int32_t)i;
+        }
+        std::vector<uint32_t> order(count), widths(count);
+        std::vector<uint8_t> seen(route_at.size(), 0);
+        for (uint32_t i = 0; i < count; ++i) {
+            const int32_t flat = sorted[i];
