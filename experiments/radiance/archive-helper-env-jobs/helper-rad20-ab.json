  "--radiance-home",
  "${RAD_HOME}",
  "--kernels",
  "libr4d,libr3moe,libref",
  "--placement",
  "expert_tiered",
  "--ngram-placement",
  "ram",
  "--max-num-seqs",
  "6",
  "--max-num-batched-tokens",
  "4096",
