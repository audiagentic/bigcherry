diff --git a/tools/bigcherry/release/platform_intent.py b/tools/bigcherry/release/platform_intent.py
new file mode 100644
index 000000000..a3f8f8b3b
--- /dev/null
+++ b/tools/bigcherry/release/platform_intent.py
@@ -0,0 +1,53 @@
+"""Require an explicit platform change entry for platform-scoped release PRs.
+
+release-please uses the `platform/` package path; this guard prevents
+accidental scope switches and omissions in squash-merged PRs.
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+from collections.abc import Iterable
+
+_PLAT_TITLE = re.compile(r"^(?:feat|fix|perf)\(platform\)!?: .+")
+_MARKER = re.compile(r"^platform/changes/(?!README\.md$)[^/]+\.md$")
+
+
+def check_intent(title: str, updated_paths: Iterable[str]) -> None:
+    """Validate the intent recorded in a PR title against changed marker files."""
+    has_marker = any(_MARKER.fullmatch(path) for path in updated_paths)
+    requests_platform_release = bool(_PLAT_TITLE.fullmatch(title))
+    if requests_platform_release and not has_marker:
+        raise ValueError(
+            "A feat/fix/perf(platform) PR needs a platform/changes/<topic>.md entry "
+            "in the same PR"
+        )
+    if has_marker and not requests_platform_release:
+        raise ValueError(
+            "A platform/changes entry requires a feat(platform), fix(platform) "
+            "or perf(platform) PR title"
+        )
+
+
+def main() -> int:
+    title = os.environ.get("PR_TITLE", "")
+    # On pull_request workflows HEAD is the test merge commit; its first
+    # parent is the base branch. Checkout with fetch-depth: 2.
+    changed = subprocess.run(
+        ["git", "diff", "--diff-filter=AM", "--name-only", "HEAD^1", "HEAD"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.splitlines()
+    try:
+        check_intent(title, changed)
+    except ValueError as exc:
+        print(f"platform release intent: {exc}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
