@@ -0,0 +1,95 @@
+"""The platform release is deliberately scoped, not the repository catch-all."""
+from __future__ import annotations
+
+import json
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def eligible_packages(files: tuple[str, ...], packages: dict) -> set[str]:
+    """Model release-please's package-path inclusion for path-scoping tests."""
+    out = set()
+    for package_path, config in packages.items():
+        relevant = [name for name in files if name.startswith(package_path + "/")]
+        if not relevant:
+            continue
+        excludes = config.get("exclude-paths", [])
+        if excludes and all(
+            any(name.startswith(exclude.rstrip("/") + "/") for exclude in excludes)
+            for name in relevant
+        ):
+            continue
+        out.add(config["component"])
+    return out
+
+
+class PlatformReleaseBoundaryTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.configuration = json.loads((ROOT / "release-please-config.json").read_text(encoding="utf-8"))
+        cls.packages = cls.configuration["packages"]
+        cls.manifest = json.loads((ROOT / ".release-please-manifest.json").read_text(encoding="utf-8"))
+
+    def test_platform_package_has_explicit_directory_and_stable_version(self) -> None:
+        self.assertNotIn(".", self.packages)
+        self.assertNotIn(".", self.manifest)
+        self.assertEqual(set(self.packages), set(self.manifest))
+        self.assertEqual(self.packages["platform/changes"]["component"], "bc-platform")
+        self.assertEqual(self.manifest["platform/changes"], "1.3.0")
+        self.assertEqual(self.packages["platform/changes"]["version-file"], "release-state/version.txt")
+        self.assertEqual(self.packages["platform/changes"]["changelog-path"], "release-state/CHANGELOG.md")
+        self.assertEqual((ROOT / "platform/changes/release-state/version.txt").read_text(encoding="utf-8"), "1.3.0\n")
+        self.assertEqual(self.packages["platform/changes"]["exclude-paths"], ["platform/changes/release-state"])
+        self.assertTrue((ROOT / "platform/changes/release-state/CHANGELOG.md").is_file())
+        self.assertIn("bc-platform-1.3.0", (ROOT / "platform/changes/release-state/CHANGELOG.md").read_text(encoding="utf-8"))
+
+    def test_engine_changes_with_shared_docs_and_tests_do_not_count_as_platform(self) -> None:
+        # Simulate previously mis-attributed release-please changes that span directories.
+        for files in (
+            ("engines/radiance/components/libr3/helper/moe_remote_shm.h",
+             "docs/planning/active/build-radiance-components/RCS09.md"),
+            ("engines/radiance/components/bc-gfx12/bc_moe_gemv.hip",
+             "tools/tests/core/test_components.py",
+             "docs/reference/tooling/TOOL_DISPOSITION.md"),
+            ("engines/llamacpp/patches/1237_rd30_moe_mmq_compact_grid/patch.py",
+             "docs/releases/notes/bc-llamacpp-11552.3.0.md"),
+            ("tools/lab/radiance/bench.sh", "docs/evidence/RAD46/result.md"),
+            ("tools/bigcherry/engine_adapters/radiance.py",
+             "docs/design/moe-remote.md"),
+            ("docs/releases/notes/bc-radiance-1160.0.0.md",),
+            ("platform/changes/release-state/CHANGELOG.md", "platform/changes/release-state/version.txt"),
