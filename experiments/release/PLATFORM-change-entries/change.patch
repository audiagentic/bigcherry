@@ -0,0 +1,66 @@
+"""The PR gate must reject unintentional or missing platform release entries."""
+from __future__ import annotations
+
+import os
+import subprocess
+import unittest
+from unittest import mock
+
+from bigcherry.release import platform_intent
+
+
+class PlatformIntentTests(unittest.TestCase):
+    def test_explicit_platform_changes_are_allowed(self) -> None:
+        for title in ("feat(platform): new shared build graph",
+                      "fix(platform): correct multi-engine admission",
+                      "perf(platform): shared benchmark throughput",
+                      "feat(platform)!: revise shared manifest"):
+            with self.subTest(title=title):
+                platform_intent.check_intent(title, [
+                    "tools/bigcherry/build/runner.py",
+                    "platform/changes/shared-build.md",
+                ])
+
+    def test_platform_scoped_title_requires_a_note(self) -> None:
+        with self.assertRaisesRegex(ValueError, "needs a"):
+            platform_intent.check_intent(
+                "feat(platform): new shared build graph",
+                ["tools/bigcherry/build/runner.py", "platform/README.md"],
+            )
+
+    def test_engine_scoped_commit_cannot_smuggle_platform_note(self) -> None:
+        for title in ("feat(radiance): optimize helper",
+                      "fix(llamacpp): correct HIP dispatch",
+                      "chore(release): migrate platform package"):
+            with self.subTest(title=title), self.assertRaisesRegex(ValueError, "requires a"):
+                platform_intent.check_intent(title, ["platform/changes/accidental.md"])
+
+    def test_readme_and_generated_platform_release_pr_do_not_trigger(self) -> None:
+        platform_intent.check_intent("chore(release): package migration", [
+            "platform/README.md", "platform/changes/README.md",
+            "platform/CHANGELOG.md", "platform/version.txt",
+        ])
+        platform_intent.check_intent("release: bc-platform 1.4.0", [
+            "platform/CHANGELOG.md", "platform/version.txt",
+            ".release-please-manifest.json",
+        ])
+
+    def test_ci_entrypoint_uses_actual_changed_paths(self) -> None:
+        with mock.patch.dict(os.environ, {"PR_TITLE": "fix(platform): shared patcher"}), \
+             mock.patch.object(subprocess, "run", return_value=mock.Mock(
+                 stdout="platform/changes/patcher.md\ntools/bigcherry/patch/api.py\n"
+             )) as run:
+            self.assertEqual(platform_intent.main(), 0)
+        self.assertEqual(run.call_args.args[0], [
+            "git", "diff", "--diff-filter=AM", "--name-only", "HEAD^1", "HEAD"
+        ])
+        with mock.patch.dict(os.environ, {"PR_TITLE": "feat(radiance): helper"}), \
+             mock.patch.object(subprocess, "run", return_value=mock.Mock(
+                 stdout="platform/changes/patcher.md\n"
+             )):
+            with mock.patch("sys.stderr"):
+                self.assertEqual(platform_intent.main(), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
