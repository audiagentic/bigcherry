  // libr3 native: the activation rows widened to bf16 ONCE a block into shared memory, a K slab at a time (not 16 codes a lane a
  // step, a quarter of the kernel's vector work). One row tile: M <= 16, so a slab is at least 1024 of K.
  __shared__ __attribute__((aligned(32))) unsigned short r3_sAct[24576];
  const bool r3_stage = true;
  const int r3_slab = (24576 / M - 16) / 1024 * 1024;
  const int ref = (int)Wref[nt * 16 + ac];
@@ end

