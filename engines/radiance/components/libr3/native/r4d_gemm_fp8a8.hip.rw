# libr3 (VTP37 step 3a): the narrow 8-bit GEMM keeps its unguarded (`Full`) form when only the token count is ragged.
#
# libr4d instantiates `Full` only when N, K and the token count M are all whole tiles. `Full` drops three guards at
# once: the weight-row guard, the K-segment guard and the token guard. At 17-31 tokens (6-8 decode streams at
# speculation depth 3, nt = 2) M is ragged, so the kernel ran fully guarded, and on gfx1100 that costs more than doing
# 32 tokens unguarded: 5120 x 5120 int8 100-103 us at M 17-31 against 83 us at M 32; 11264 x 5120 136-140 against
# 125 (`r3_selftest --perfw8 --cold 256`). Here the token guard is always kept (a scalar compare per staged row, per
# scale and per output tile) and `Full` follows N and K alone, so a ragged token count no longer brings back the
# weight-row and K guards. Output bits do not change: the same products are summed in the same order, and only rows
# past M, which were never stored, are skipped.

@@ find 1
                            k_live && r < FN && (Full || (n0 + r) < nb));
@@ replace
                            k_live && r < FN && (n0 + r) < nb);   // libr3: the token guard always
@@ end

@@ find 1
        return ((Full || tok < nb) && kb < nkb8) ? ((const float*)Sb)[(size_t)tok * sb_ld + kb]
@@ replace
        return (tok < nb && kb < nkb8) ? ((const float*)Sb)[(size_t)tok * sb_ld + kb]   // libr3
@@ end

@@ find 1
                                        live && (Full || (n0 + r) < nb));
@@ replace
                                        live && (n0 + r) < nb);   // libr3: the token guard always
@@ end

@@ find 2
                if (!Full && n0 + wn + j * 16u >= nb) continue;
@@ replace
                if (n0 + wn + j * 16u >= nb) continue;   // libr3: the token guard always
@@ end

@@ find 1
                if (!Full && tok >= nb) continue;
@@ replace
                if (tok >= nb) continue;   // libr3: the token guard always
@@ end

@@ find 1
            if (!Full && col >= nb) continue;
@@ replace
            if (col >= nb) continue;   // libr3: the token guard always
@@ end

@@ find 1
    const bool full = ((uint32_t)N % fm == 0) && ((uint32_t)M % (nt * 16u) == 0) &&
@@ replace
    const bool full = ((uint32_t)N % fm == 0) &&   // libr3: tokens are always guarded, so M may be ragged
@@ end

# VTP37: keep the 256-K group's two 128-K WMMA units rolled for NT >= 2 on gfx1100.
# Reduces the lifetime of weight/token prefetches across token tiles without changing
# integer accumulation, scale folds or wave reduction. SB128 and NT1 keep full unrolling.
@@ find 1
#pragma unroll
        for (uint32_t h = 0; h < kUG; ++h) {
@@ replace
#pragma unroll ((SB == 256u && NT >= 2u) ? 1u : kUG)  // libr3: SB256 multi-tile
        for (uint32_t h = 0; h < kUG; ++h) {
@@ end

# VTP37: keep the iu8 WMMA sum in gfx11 accumulator layout within each scale group.
# Convert once per group, before the existing float scale fold; other kernels are unchanged.
@@ find 1
        f8v raw[NT];   /* int32 sums */
#pragma unroll
        for (uint32_t j = 0; j < NT; ++j) raw[j] = acc_zero();
@@ replace
        f8v raw[NT];   /* gfx12 layout for the scale fold */
        r3_i8 raw11[NT];   /* accumulate in the native gfx11 layout across this group */
#pragma unroll
        for (uint32_t j = 0; j < NT; ++j) raw11[j] = r3_i8{0, 0, 0, 0, 0, 0, 0, 0};
@@ end

@@ find 1
                    raw[j] = mma8<true>(frag_of(ac[ks / 4u], ks % 4u), bq[j & 1u][ks], raw[j]);
@@ replace
                    raw11[j] = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(
                        true, r3_bytes_12_to_11(__builtin_bit_cast(r3_i2, frag_of(ac[ks / 4u], ks % 4u)), lane),
                        true, r3_bytes_12_to_11(__builtin_bit_cast(r3_i2, bq[j & 1u][ks]), lane), raw11[j], false);
@@ end

@@ find 1
        const uint4 q4 = *(const uint4*)(Sa + ((size_t)rt * ngrp + g) * 16u + acc_row(lane, 0));
@@ replace
#pragma unroll
        for (uint32_t j = 0; j < NT; ++j)
            raw[j] = __builtin_bit_cast(f8v, r3_acc_i32_11_to_12(raw11[j], lane));
        const uint4 q4 = *(const uint4*)(Sa + ((size_t)rt * ngrp + g) * 16u + acc_row(lane, 0));
@@ end
