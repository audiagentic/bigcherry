# libr3 (VTP37 step 3a): the narrow 8-bit GEMM keeps its unguarded (`Full`) form when only the token count is ragged.
#
# libr4d instantiates `Full` only when N, K and the token count M are all whole tiles. `Full` drops three guards at
# once: the weight-row guard, the K-segment guard and the token guard. At 17-31 tokens (6-8 decode streams at
# speculation depth 3, nt = 2) M is ragged, so the kernel ran fully guarded, and on gfx1100 that costs more than doing
# 32 tokens unguarded: 5120 x 5120 int8 100-103 us at M 17-31 against 83 us at M 32; 11264 x 5120 136-140 against
# 125 (`r3_selftest --perfw8 --cold 256`). Here the token guard is always kept (a scalar compare per staged row, per
# scale and per output tile) and `Full` follows N and K alone, so a ragged token count no longer brings back the
# weight-row and K guards. Output bits do not change: the same products are summed in the same order, and only rows
# past M, which were never stored, are skipped.

@@ find 1
                            k_live && r < FN && (Full || (n0 + r) < nb));
@@ replace
                            k_live && r < FN && (n0 + r) < nb);   // libr3: the token guard always
@@ end

@@ find 1
        return ((Full || tok < nb) && kb < nkb8) ? ((const float*)Sb)[(size_t)tok * sb_ld + kb]
@@ replace
        return (tok < nb && kb < nkb8) ? ((const float*)Sb)[(size_t)tok * sb_ld + kb]   // libr3
@@ end

@@ find 1
                                        live && (Full || (n0 + r) < nb));
@@ replace
                                        live && (n0 + r) < nb);   // libr3: the token guard always
@@ end

@@ find 2
                if (!Full && n0 + wn + j * 16u >= nb) continue;
@@ replace
                if (n0 + wn + j * 16u >= nb) continue;   // libr3: the token guard always
@@ end

@@ find 1
                if (!Full && tok >= nb) continue;
@@ replace
                if (tok >= nb) continue;   // libr3: the token guard always
@@ end

@@ find 1
            if (!Full && col >= nb) continue;
@@ replace
            if (col >= nb) continue;   // libr3: the token guard always
@@ end

@@ find 1
    const bool full = ((uint32_t)N % fm == 0) && ((uint32_t)M % (nt * 16u) == 0) &&
@@ replace
    const bool full = ((uint32_t)N % fm == 0) &&   // libr3: tokens are always guarded, so M may be ragged
@@ end

# VTP37: keep the 256-K group's two 128-K WMMA units rolled for NT >= 2 on gfx1100.
# Reduces the lifetime of weight/token prefetches across token tiles without changing
# integer accumulation, scale folds or wave reduction. SB128 and NT1 keep full unrolling.
@@ find 1
#pragma unroll
        for (uint32_t h = 0; h < kUG; ++h) {
@@ replace
#pragma unroll ((SB == 256u && NT >= 2u) ? 1u : kUG)  // libr3: SB256 multi-tile
        for (uint32_t h = 0; h < kUG; ++h) {
@@ end

# VTP37: keep the iu8 WMMA sum in gfx11 accumulator layout within each scale group.
# Convert once per group, before the existing float scale fold; other kernels are unchanged.
@@ find 1
        f8v raw[NT];   /* int32 sums */
#pragma unroll
        for (uint32_t j = 0; j < NT; ++j) raw[j] = acc_zero();
@@ replace
        f8v raw[NT];   /* gfx12 layout for the scale fold */
        r3_i8 raw11[NT];   /* accumulate in the native gfx11 layout across this group */
#pragma unroll
        for (uint32_t j = 0; j < NT; ++j) raw11[j] = r3_i8{0, 0, 0, 0, 0, 0, 0, 0};
@@ end

@@ find 1
                    raw[j] = mma8<true>(frag_of(ac[ks / 4u], ks % 4u), bq[j & 1u][ks], raw[j]);
@@ replace
                    raw11[j] = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(
                        true, r3_bytes_12_to_11(__builtin_bit_cast(r3_i2, frag_of(ac[ks / 4u], ks % 4u)), lane),
                        true, r3_bytes_12_to_11(__builtin_bit_cast(r3_i2, bq[j & 1u][ks]), lane), raw11[j], false);
@@ end

@@ find 1
        const uint4 q4 = *(const uint4*)(Sa + ((size_t)rt * ngrp + g) * 16u + acc_row(lane, 0));
@@ replace
#pragma unroll
        for (uint32_t j = 0; j < NT; ++j)
            raw[j] = __builtin_bit_cast(f8v, r3_acc_i32_11_to_12(raw11[j], lane));
        const uint4 q4 = *(const uint4*)(Sa + ((size_t)rt * ngrp + g) * 16u + acc_row(lane, 0));
@@ end

# VTP37: the K-parallel scale-group weight/token look-ahead is an occupancy cost on gfx1100.
# Model only the register rings and simultaneously-live arrays from their actual types,
# never a per-model/per-N/K/M register lookup. This model is deliberately applicable only
# when the number of token tiles does not exceed the 128-K units in the scale group:
# with additional token tiles the inter-tile bq load scheduling changes the compiler's
# liveness, and measured NT3/NT4 and SB128 NT2 resources do not follow the simple model.
# The physical gfx1100 wave32 register file holds 1536 VGPR per SIMD. Keep the kernel's
# existing waves-per-EU hint: the model is not an exact compiled VGPR predictor.
@@ find 1
    Stage8 ac[2], an[2];
    i2v bc[8], bn[8], bq[2][8];
    if (wave < ngrp) {
        aload(wave * kUG, ac);
        bload(0u, wave * kUG, bc);
    }
@@ replace
    // Count 32-bit words in the actual live operand, accumulator and look-ahead types.
    // The model is valid for the one/two-token-tile scheduling forms only; wider NT
    // reorders bq lifetimes (the 2020.8.3 resource records do not fit this model).
    constexpr uint32_t kVgprFilePerSimd = 1536u; // gfx1100, wave32
    constexpr uint32_t kRingRegs = (sizeof(Stage8[2]) + sizeof(i2v[8])) / sizeof(uint32_t);
    constexpr uint32_t kLiveRegs =
        (sizeof(Stage8[2]) + sizeof(i2v[8]) + sizeof(i2v[2][8]) +
         sizeof(f8v[NT]) + sizeof(r3_i8[NT]) + sizeof(f8v[NT]) +
         sizeof(const int8_t*[NT]) + sizeof(const float*[NT])) / sizeof(uint32_t);
    constexpr bool kDropAhead = (NT <= kUG) &&
        (kVgprFilePerSimd / (kLiveRegs + kRingRegs) <
         kVgprFilePerSimd / kLiveRegs);
    Stage8 ac[2], an[2];
    i2v bc[8], bn[8], bq[2][8];
    if constexpr (!kDropAhead) {
        if (wave < ngrp) {
            aload(wave * kUG, ac);
            bload(0u, wave * kUG, bc);
        }
    }
@@ end

@@ find 1
            const uint32_t un = h + 1u < kUG ? u + 1u : (g + KW) * kUG;
            if (un < nunit) {
                aload(un, an);
                bload(0u, un, bn);
            }
@@ replace
            if constexpr (kDropAhead) {
                aload(u, ac);
                bload(0u, u, bc);
            } else {
                const uint32_t un = h + 1u < kUG ? u + 1u : (g + KW) * kUG;
                if (un < nunit) {
                    aload(un, an);
                    bload(0u, un, bn);
                }
            }
@@ end

@@ find 1
#pragma unroll
            for (uint32_t p = 0; p < 2; ++p) ac[p] = an[p];
#pragma unroll
            for (uint32_t ks = 0; ks < 8; ++ks) bc[ks] = bn[ks];
@@ replace
            if constexpr (!kDropAhead) {
#pragma unroll
                for (uint32_t p = 0; p < 2; ++p) ac[p] = an[p];
#pragma unroll
                for (uint32_t ks = 0; ks < 8; ++ks) bc[ks] = bn[ks];
            }
@@ end

# VTP50: native row-major token fragments for the gfx11 K-parallel integer tile.
# The two wave halves each load the same contiguous 16-K row. Keep the existing
# weight-layout conversion and the scale-group accumulator conversion unchanged.
@@ find 1
    const int8_t* xrow[NT];
@@ replace
    // With extra token tiles the overlapping B loads change register liveness.
    // Native row loads retain or improve compiled resources at NT3 and when
    // the token-tile count fits the 128-K units in the scale group.
    constexpr bool kNativeB = (NT == 3u) || (NT <= SB / 128u);
    using BFrag = std::conditional_t<kNativeB, r3_i4, i2v>;
    const int8_t* xrow[NT];
@@ end

@@ find 1
        xrow[j] = Bp + (size_t)tok * b_ld + frag_k0(lane);
@@ replace
        xrow[j] = Bp + (size_t)tok * b_ld + (kNativeB ? 0u : frag_k0(lane));
@@ end

@@ find 1
    auto bload = [&](uint32_t j, uint32_t u, i2v (&b)[8]) {
#pragma unroll
        for (uint32_t ks = 0; ks < 8; ++ks) {
            const uint2 v = *(const uint2*)(xrow[j] + u * kBlock + ks * kK);
            b[ks][0] = (int)v.x;
            b[ks][1] = (int)v.y;
        }
    };
@@ replace
    auto bload = [&](uint32_t j, uint32_t u, BFrag (&b)[8]) {
#pragma unroll
        for (uint32_t ks = 0; ks < 8; ++ks) {
            if constexpr (kNativeB) {
                const uint4 v = *(const uint4*)(xrow[j] + u * kBlock + ks * kK);
                b[ks] = r3_i4{(int)v.x, (int)v.y, (int)v.z, (int)v.w};
            } else {
                const uint2 v = *(const uint2*)(xrow[j] + u * kBlock + ks * kK);
                b[ks][0] = (int)v.x;
                b[ks][1] = (int)v.y;
            }
        }
    };
    auto bfrag11 = [&](BFrag v) -> r3_i4 {
        if constexpr (kNativeB) return v;
        else {
            r3_i2 half;
            __builtin_memcpy(&half, &v, sizeof(half));
            return r3_bytes_12_to_11(half, lane);
        }
    };
@@ end

