# RAD47: gemm_mxfp4a8_nt_m64, the skinny MXFP4 row (M <= 64), outranks the tiled row by priority, which is right on
# gfx1201 and wrong on gfx11: on a 7900 XTX the tiled kernel is 4 to 6 times faster from M = 17 up (27B shapes: M = 18 842 us vs 319 us,
# M = 64 3267 us vs 530 us). Put the row just BELOW the tiled row so it only serves what tiled cannot (K a multiple of 32 but not of
# 64); the value is derived from the tiled priority, not a new literal.

@@ find 1
  RAD_DOMAIN_DEVICE, R4D_PRIO_GEMM_SKINNY,
  ROW(cGemmNtMxfp4A8), ROW(tGemmSkinny), r4d_tune_valid_gemm,
@@ replace
  RAD_DOMAIN_DEVICE, R4D_PRIO_GEMM_TILED - 1,
  ROW(cGemmNtMxfp4A8), ROW(tGemmSkinny), r4d_tune_valid_gemm,
@@ end
