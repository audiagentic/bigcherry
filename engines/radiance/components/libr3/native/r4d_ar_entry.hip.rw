@@ replace
              (long)(uintptr_t)s, r3_nblocks, nthreads, cfgv.drain, cfgv.acq, wire,
              in->locpack, r3_wire4 ? in->slot_bytes / 4 : in->slot_bytes / 2, wpo ? r4d_addr(wpo) : 0, in->my_stage);
@@ end

