# libr3 runtime selector for the gfx1100 native prefill-attention instantiation.
@@ find 1
#include <algorithm>
using std::max;
@@ replace
#include <algorithm>
#include <cstdlib>
using std::max;
@@ end

@@ find 1
    hipLaunchKernelGGL((r4d_attn_prefill_kernel<P_NWARPS, P_TILE, A_HEAD_DIM, A_GQA, A_BLOCK_SIZE,
                                                KVP, P_OPT>),
                       grid, dim3(P_NWARPS * 32), 0, s, *a);
@@ replace
    const char* r3n = std::getenv("R3_ATTN_NATIVE");
    if (!(r3n && *r3n == '0'))
        hipLaunchKernelGGL((r4d_attn_prefill_kernel<P_NWARPS, P_TILE, A_HEAD_DIM, A_GQA, A_BLOCK_SIZE,
                                                    KVP, P_OPT | O_R3NATIVE>),
                           grid, dim3(P_NWARPS * 32), 0, s, *a);
    else
        hipLaunchKernelGGL((r4d_attn_prefill_kernel<P_NWARPS, P_TILE, A_HEAD_DIM, A_GQA, A_BLOCK_SIZE,
                                                    KVP, P_OPT>),
                           grid, dim3(P_NWARPS * 32), 0, s, *a);
@@ end
