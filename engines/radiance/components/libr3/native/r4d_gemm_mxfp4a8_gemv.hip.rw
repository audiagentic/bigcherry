# Native gfx11 matrix products for r4d_gemm_mxfp4a8_gemv (radiance 1.13.0: the MXFP4 GEMM for one to eight rows, 64 with K
# a multiple of 128; the plain WMMA form and the two gated forms), the row that serves every decode step.
#
# libr4d: the WEIGHT is the matrix instruction's A operand (a lane holds its column's 8 codes of a k-half, unpacked to
# e4m3 in registers) and the activation rows its B operand; D's row 8h + e (slot e of lane half h) is output column
# 8h + e, its column the activation row (lane & 15). Native: the gfx11 instruction takes whole 16-code rows, so a lane
# loads ONE dword of its column's codes (its own k half; the fragment-order weight is read once, not once a half),
# unpacks it, swaps the 8 e4m3 codes with the partner lane (lane ^ 16, same column, other half) and widens the 16 to bf16; the activation row is 16 contiguous bytes widened the same way.
# gfx11 puts D row 2e + h in slot e of half h, so the lane that supplies A row m' supplies output column
# ac = r3_arow(m') = 8 * (m' & 1) + (m' >> 1) (r3_compat.h): then slot e of half h holds output column 8h + e again, and
# the epilogues, sP stores and the activation-scale fold stay as written. The chain of eight products per 128 of K starts
# from a zero accumulator exactly as before; nothing leaves the gfx11 layout.
#
# The dot form (K % 128 == 64) still multiplies with the dot4 shim; no Qwen projection takes it (K is 5120 or 17408).

# ---- the plain form (r4d_gemm_mxfp4a8_gemvw_kernel)
@@ find 1
  const int col = lane & 15, khalf = lane >> 4;  // B fragment: this lane's column and k half
@@ replace
  const int col = lane & 15, khalf = lane >> 4;  // B fragment: this lane's column and k half
  const int ac = (int)r3_arow((unsigned)lane);   // libr3 native: the weight column this lane supplies as an A row
@@ end

@@ find 1
  for (int t = 0; t < TN; ++t) ref[t] = (int)Wref[(nt0 + t) * 16 + col];
@@ replace
  for (int t = 0; t < TN; ++t) ref[t] = (int)Wref[(nt0 + t) * 16 + ac];
@@ end

@@ find 1
    unsigned wv[TN][8];
#pragma unroll
    for (int t = 0; t < TN; ++t)
#pragma unroll
      for (int s = 0; s < 8; ++s)
        wv[t][s] = __builtin_nontemporal_load(&Wp[((size_t)(nt0 + t) * ksteps + ch * 8 + s) * 32 + lane]);
@@ replace
    unsigned wv[TN][8];
#pragma unroll
    for (int t = 0; t < TN; ++t)
#pragma unroll
      for (int s = 0; s < 8; ++s)
        wv[t][s] = __builtin_nontemporal_load(&Wp[((size_t)(nt0 + t) * ksteps + ch * 8 + s) * 32 + (lane & 16) + ac]);
@@ end

@@ find 1
      for (int q = 0; q < 4; ++q) e8[t][q] = (int)Ws[(size_t)(ch * 4 + q) * ldws + (nt0 + t) * 16 + col];
@@ replace
      for (int q = 0; q < 4; ++q) e8[t][q] = (int)Ws[(size_t)(ch * 4 + q) * ldws + (nt0 + t) * 16 + ac];
@@ end

@@ find 1
    mxg_v2i wf[TN][8];
#pragma unroll
    for (int t = 0; t < TN; ++t)
#pragma unroll
      for (int s = 0; s < 8; ++s) {
        unsigned lo, hi;
        r4d_mxfp4_unpack8(wv[t][s], r4d_mxfp4_fold_d(ref[t], e8[t][s >> 1]), &lo, &hi);
        wf[t][s][0] = (int)lo; wf[t][s][1] = (int)hi;
      }
@@ replace
    r3_v16bf wf[TN][8];
#pragma unroll
    for (int t = 0; t < TN; ++t)
#pragma unroll
      for (int s = 0; s < 8; ++s) {
        unsigned lo, hi;
        r4d_mxfp4_unpack8(wv[t][s], r4d_mxfp4_fold_d(ref[t], e8[t][s >> 1]), &lo, &hi);
        wf[t][s] = r3_row16_e4m3_regs_to_bf16(lo, hi, (unsigned)lane);
      }
@@ end

# the activation rows: shared by the plain and the gated-wide forms
@@ find 2
      mxg_v2i af[8];
#pragma unroll
      for (int s = 0; s < 8; ++s) {
        if (live) {
          const unsigned* pa = (const unsigned*)(A + (size_t)row * lda + (ch * 8 + s) * 16 + khalf * 8);
          af[s][0] = (int)pa[0]; af[s][1] = (int)pa[1];
        } else {
          af[s][0] = 0; af[s][1] = 0;
        }
      }
@@ replace
      r3_v16bf af[8];
#pragma unroll
      for (int s = 0; s < 8; ++s)
        af[s] = live ? r3_e4m3x16_to_bf16(*reinterpret_cast<const r3_u4u*>(A + (size_t)row * lda + (ch * 8 + s) * 16))
                     : r3_v16bf{};
@@ end

@@ find 2
          acc = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(wf[t][s], af[s], acc);
@@ replace
          acc = r3_wmma_bf16_native(wf[t][s], af[s], acc);
@@ end

# ---- the gated forms: the column line is shared by the narrow and the wide one
@@ find 2
  const int col = lane & 15, khalf = lane >> 4;
@@ replace
  const int col = lane & 15, khalf = lane >> 4;
  const int ac = (int)r3_arow((unsigned)lane);   // libr3 native: the weight column this lane supplies as an A row
@@ end

# the narrow gated form (r4d_gemm_mxfp4a8_gated_kernel): one row tile, a K wave each
@@ find 1
  const int ref = (int)Wref[nt * 16 + col];
@@ replace
  const int ref = (int)Wref[nt * 16 + ac];
@@ end

@@ find 1
    unsigned wv[8];
#pragma unroll
    for (int s = 0; s < 8; ++s)
      wv[s] = __builtin_nontemporal_load(&Wp[((size_t)nt * ksteps + ch * 8 + s) * 32 + lane]);
@@ replace
    unsigned wv[8];
#pragma unroll
    for (int s = 0; s < 8; ++s)
      wv[s] = __builtin_nontemporal_load(&Wp[((size_t)nt * ksteps + ch * 8 + s) * 32 + (lane & 16) + ac]);
@@ end

@@ find 1
    for (int q = 0; q < 4; ++q) e8[q] = (int)Ws[(size_t)(ch * 4 + q) * ldws + nt * 16 + col];
@@ replace
    for (int q = 0; q < 4; ++q) e8[q] = (int)Ws[(size_t)(ch * 4 + q) * ldws + nt * 16 + ac];
@@ end

@@ find 1
    mxg_v2i af[8];
#pragma unroll
    for (int s = 0; s < 8; ++s) {
      if (live) {
        const unsigned* pa = (const unsigned*)(A + (size_t)row * lda + (ch * 8 + s) * 16 + khalf * 8);
        af[s][0] = (int)pa[0]; af[s][1] = (int)pa[1];
      } else {
        af[s][0] = 0; af[s][1] = 0;
      }
    }
@@ replace
    r3_v16bf af[8];
#pragma unroll
    for (int s = 0; s < 8; ++s)
      af[s] = live ? r3_e4m3x16_to_bf16(*reinterpret_cast<const r3_u4u*>(A + (size_t)row * lda + (ch * 8 + s) * 16))
                   : r3_v16bf{};
@@ end

@@ find 1
      unsigned lo, hi;
      r4d_mxfp4_unpack8(wv[s], r4d_mxfp4_fold_d(ref, e8[s >> 1]), &lo, &hi);
      mxg_v2i wf;
      wf[0] = (int)lo; wf[1] = (int)hi;
      acc = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(wf, af[s], acc);
@@ replace
      unsigned lo, hi;
      r4d_mxfp4_unpack8(wv[s], r4d_mxfp4_fold_d(ref, e8[s >> 1]), &lo, &hi);
      acc = r3_wmma_bf16_native(r3_row16_e4m3_regs_to_bf16(lo, hi, (unsigned)lane), af[s], acc);
@@ end

# the wide gated form (r4d_gemm_mxfp4a8_gatedw_kernel): RT row tiles, gate and up tiles
@@ find 1
  for (int t = 0; t < 2; ++t) ref[t] = (int)Wref[nt[t] * 16 + col];
@@ replace
