#pragma unroll
    for (int t = 0; t < 2; ++t)
#pragma unroll
      for (int s = 0; s < 8; ++s) {
        unsigned lo, hi;
        r4d_mxfp4_unpack8(wv[t][s], r4d_mxfp4_fold_d(ref[t], e8[t][s >> 1]), &lo, &hi);
        wf[t][s][0] = (int)lo; wf[t][s][1] = (int)hi;
      }
@@ replace
