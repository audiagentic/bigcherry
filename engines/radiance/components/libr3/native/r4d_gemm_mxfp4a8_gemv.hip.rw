  const int r3_kn = K - r3_k0 < r3_slab ? K - r3_k0 : r3_slab;
  if (r3_stage) {
    __syncthreads();   // the previous slab's reads are done
    for (int i = threadIdx.x; i < M * r3_kn; i += blockDim.x) {
      const int m = i / r3_kn;
      r3_sAct[m * (r3_kn + 16) + (i - m * r3_kn)] = (unsigned short)r3_e4m3_to_bf16_bits(A[(size_t)m * lda + r3_k0 + (i - m * r3_kn)]);
    }
    __syncthreads();
  }
  for (int ch = (r3_k0 >> 7) + wave; ch < ((r3_k0 + r3_kn) >> 7); ch += KW) {
