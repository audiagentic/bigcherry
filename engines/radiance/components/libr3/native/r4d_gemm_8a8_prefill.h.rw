        if constexpr (I8 && RB == 0 && !ROWF) {
            if (tid < kPBN) {
                const uint32_t row = n0 + tid;
                s_ws_i8[kb & 1u][tid] = Sw[((size_t)(row / 16u) * nkb + kb) * 16u + (row & 15u)];
            }
        }
#endif
        // The weight's scales for this block, read ahead of the two tiles that hide them: one bf16
@@ end

