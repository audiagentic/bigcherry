    auto storeV = [&]() {
        if constexpr (R3N) {
            constexpr int VE = KVP ? 8 : 16;
            constexpr int NITEM = TILE * (HEAD_DIM / VE);
            #pragma unroll
            for (int r = 0; r < VREGS; ++r) {
                const int item = tid + r * NTHR;
                if (item < NITEM) {
                    const int key = item / (HEAD_DIM / VE);
                    const int dg  = item - key * (HEAD_DIM / VE);
                    const int d0  = dg * VE;
                    const r3_u4 raw = __builtin_bit_cast(r3_u4, vreg[r]);
                    uint32_t hw[8];
                    if constexpr (KVP) {
                        #pragma unroll
                        for (int d = 0; d < 4; ++d) hw[d] = D::from_bf16w(raw[d]);
                    } else {
                        fp8x8_to_16x4w<D>(make_uint2(raw[0], raw[1]), hw);
                        fp8x8_to_16x4w<D>(make_uint2(raw[2], raw[3]), hw + 4);
                    }
                    #pragma unroll
                    for (int d = 0; d < VE / 2; ++d) {
                        sV16[(d0 + 2 * d)     * VSTR + key] = (uint16_t)hw[d];
                        sV16[(d0 + 2 * d + 1) * VSTR + key] = (uint16_t)(hw[d] >> 16);
                    }
                }
            }
            return;
        }
        #pragma unroll
        for (int r = 0; r < VREGS; ++r) {
            const int idx = warp + r * NWARPS;
@@ end

