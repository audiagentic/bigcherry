@@ replace
            const int kbase = k0 + mt * 16 + (R3N ? h : 8 * h);
            // Native keeps the accumulator layout: lane (c,h) holds keys kbase + 2e, so the lowest
            // key a lane scores is kbase (the WIN test) and the highest is kbase + 14.
            if (!MSKIP || wave_any(kbase + (R3N ? 14 : 7) > klimit) || (WIN && wave_any(kbase < wlo))) {
                #pragma unroll
                for (int e = 0; e < 8; ++e) {
                    const int key = kbase + (R3N ? 2 * e : e);
                    sc[e] = ((key <= klimit) && (!WIN || key >= wlo)) ? sc[e] : -INFINITY;
                }
            }
