@@ replace
    constexpr int KWIDE = (OPT & O_KWIDE) ? 1 : 0;
    constexpr int R3N   = (OPT & O_R3NATIVE) ? 1 : 0;
    static_assert(!R3N || F16, "gfx11 native attention uses the f16 operand form");
    static_assert(!R3N || !(OPT & (O_QK8 | O_PV8)), "gfx11 native attention has no e4m3 legs");
@@ end

