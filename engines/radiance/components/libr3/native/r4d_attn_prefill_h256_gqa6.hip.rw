            const int kbase = k0 + mt * 16 + 8 * h;
            // Mask keys past klimit and, with WIN, before wlo. MSKIP skips tiles straddling neither.
            if (!MSKIP || wave_any(kbase + 7 > klimit) || (WIN && wave_any(kbase < wlo))) {
                #pragma unroll
