@@ find 1
    #pragma unroll
    for (int dt = 0; dt < NKS; ++dt) {
        uint32_t tw[4];
        #pragma unroll
        for (int e = 0; e < 8; e += 2)
            tw[e >> 1] = (uint32_t)f32_to_bf16(acc[dt][e] * inv)
                       | ((uint32_t)f32_to_bf16(acc[dt][e + 1] * inv) << 16);
        *(uint4*)(op + dt * 16 + 8 * h) = make_uint4(tw[0], tw[1], tw[2], tw[3]);
    }
@@ replace
    #pragma unroll
    for (int dt = 0; dt < NKS; ++dt) {
        const v8f ao = R3N ? r3_acc_native_to_gfx12(acc[dt]) : acc[dt];
        uint32_t tw[4];
        #pragma unroll
        for (int e = 0; e < 8; e += 2)
            tw[e >> 1] = (uint32_t)f32_to_bf16(ao[e] * inv)
                       | ((uint32_t)f32_to_bf16(ao[e + 1] * inv) << 16);
        *(uint4*)(op + dt * 16 + 8 * h) = make_uint4(tw[0], tw[1], tw[2], tw[3]);
    }
@@ end

// The KV split's epilogue store. Upstream's r4d_prefill_store_partial writes lane (c, h)'s acc[dt] as dims
// 16 dt + 8 h .. + 7 of its row (the gfx12 accumulator layout), as the bf16 store above it does. The native
// accumulator holds dim 2 e + h in element e, so it is converted once, in place (acc is dead afterwards, so no
// second 128-register array), exactly as at the bf16 store. m_ref and l_i are unchanged by the layout: m_ref is the
// row maximum over both half-waves (swap16), l_i the sum of the lane's own P values joined with its partner's.
@@ find 1
        r4d_prefill_store_partial<NKS, HEAD_DIM>(a, qoff + qpos, qhead, sp, acc, m_ref, l_i, h);
        return;
@@ replace
        if constexpr (R3N) {
            #pragma unroll
            for (int dt = 0; dt < NKS; ++dt) acc[dt] = r3_acc_native_to_gfx12(acc[dt]);
        }
        r4d_prefill_store_partial<NKS, HEAD_DIM>(a, qoff + qpos, qhead, sp, acc, m_ref, l_i, h);
        return;
@@ end
