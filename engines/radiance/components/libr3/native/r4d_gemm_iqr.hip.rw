            for (uint32_t ks = 0; ks < 8; ++ks) bc[ks] = bn[ks];
        }
@@ end

# Wide IQR tile: keep the integer sums in gfx11's native WMMA accumulator layout
# for all eight K fragments in one 128-K scale block. Convert once only when
# folding the scale; preserve the prior f32 fold and chain protocol.
@@ find 1
    f8v raw[NT], out[NT];
#pragma unroll
    for (uint32_t j = 0; j < NT; ++j) { raw[j] = acc_zero(); out[j] = acc_zero(); }
@@ replace
    f8v raw[NT], out[NT];
    r3_i8 raw11[NT];
#pragma unroll
    for (uint32_t j = 0; j < NT; ++j) {
        raw11[j] = r3_i8{0, 0, 0, 0, 0, 0, 0, 0};
        out[j] = acc_zero();
    }
@@ end

