# Single-band fused IQR prefill.
@@ find 1
/* ---- the forms built: r4d_iqr.h's list ------------------------------------------------ */
@@ replace

// Fused one-band policy: eight waves each decode one of the eight weight units.
// Reuse each wave's padded transpose storage for its two fragment-order halves.
template <class F>
struct IqrFusedPre {
    Ctx c;
    uint8_t* tr;
    __device__ void begin(uint32_t, uint32_t, uint8_t*) const {}
    __device__ void end(uint32_t) const {}
    __device__ __forceinline__ void prepare(uint32_t n0, uint32_t kb) const {
        using D = Dec<F>;
        static_assert(kPWaves == kPWW * kPTW);
        static_assert(kTrBytes >= 2u * kTileBytes);
        static_assert(kTrBytes % 16u == 0);
        const uint32_t tid = threadIdx.x, lane = tid % kWave, wave = tid / kWave;
        const uint32_t rt = n0 / 16u + wave;
        uint8_t* const t = tr + wave * kTrBytes;
        // All consumers must finish reading the preceding block before reuse.
        __syncthreads();
        uint32_t w[16];
        const typename D::Raw code = D::fetch(c, rt, kb, lane, true);
        D::rows(code, c, rb_ratio<F>(c, rt * 16u + (lane & 15u), kb), w);
        D::unzero(c, rt, kb, w);
        Stage8 f[2];
        frag(w, t, lane, f);
        // frag's final wave-local fence/barrier precedes overwriting its transpose.
#pragma unroll
        for (uint32_t h = 0; h < 2; ++h) {
            uint8_t* const d = t + h * kTileBytes + lane * kLaneBytes;
            *(uint4*)d = f[h].v;
            *(uint4*)(d + 16) = f[h].w;
        }
        __syncthreads();
    }
    __device__ __forceinline__ Stage8 load(uint32_t part, uint32_t half, uint32_t lane) const {
        const uint8_t* const p = tr + part * kTrBytes + half * kTileBytes + lane * kLaneBytes;
        Stage8 f;
        f.v = *(const uint4*)p;
        f.w = *(const uint4*)(p + 16);
        return f;
    }
};

// Qualified compiled records: 236–239 VGPR, zero spill, 6 waves, 36864 bytes LDS.
template <class F>
struct IqrFusedCertificate {
    static constexpr uint32_t lds = kPrefillLds + 2u * kPBM * sizeof(float)
                                  + kPWaves * kTrBytes + Dec<F>::kTab;
    static constexpr bool geometry = kPWaves == kPWW * kPTW &&
        kTrBytes >= 2u * kTileBytes && kTrBytes % 16u == 0u;
    static constexpr bool rowf = F::SC == kRowF32 &&
        ((F::L == 16u && F::B >= 2u && F::B <= 7u) ||
         (F::L == 15u && F::B == 2u));
    static constexpr bool bf16 = F::SC == kBf16 && F::L == 16u &&
        F::B >= 4u && F::B <= 7u;
    static constexpr bool verified = geometry && F::KIND == kTrellisMad &&
        F::LV == 0u && F::LRB == 0u && (rowf || bf16);
};

template <class F>
__global__ __launch_bounds__(kPWaves * kWave) R4D_WAVES(6)
void iqr_fused_prefill_kernel(Ctx c, const uint8_t* __restrict__ A, const float* __restrict__ Sa,
                              const uint16_t* __restrict__ Sw, uint16_t* __restrict__ C,
                              uint32_t M, uint32_t K, uint32_t N, uint32_t a_ld, uint32_t sa_ld) {
    using D = Dec<F>;
    __shared__ __attribute__((aligned(16))) int8_t s_tab[D::kTab];
    __shared__ __attribute__((aligned(16))) uint8_t s_tr[kPWaves * kTrBytes];
    c.tab = s_tab;
    D::stage(s_tab, c, threadIdx.x, kPWaves * kWave);
    __syncthreads();
    const IqrFusedPre<F> pre{c, s_tr};
    if constexpr (F::SC == kRowF32) {
        constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
        const uint8_t* const sb = c.S;
        gemm_8a8_prefill_body<true, 32, IqrFusedPre<F>, true, kBlock, true>(
            A, Sa, nullptr, Sw, C, M, K, N, a_ld, sa_ld, c.nkb, pre,
            (const float*)sb, (const float*)(sb + cf_off(f, N, K)));
    } else {
        static_assert(F::SC == kBf16 && F::LRB == 0);
        gemm_8a8_prefill_body<true, 0, IqrFusedPre<F>, false, kBlock, true>(
            A, Sa, nullptr, Sw, C, M, K, N, a_ld, sa_ld, c.nkb, pre);
    }
}

/* ---- the forms built: r4d_iqr.h's list ------------------------------------------------ */
@@ end
@@ find 1
    if (g.N % kPBN || (uintptr_t)g.y->data & 15u) return R4D_NO(RAD_E_SHAPE);
@@ replace
    if (g.N % kPBN || (uintptr_t)g.y->data & 15u) return R4D_NO(RAD_E_SHAPE);
    if constexpr (IqrFusedCertificate<F>::verified) {
        const uint32_t bands = (uint32_t)((g.M + kPBM - 1u) / kPBM);
        if (bands == 1u) {
            const Ctx c = ctx_of(g);
            const int rc = R4D_EMIT(stream, (iqr_fused_prefill_kernel<F>),
                dim3(bands, (uint32_t)(g.N / kPBN), 1), dim3(kPWaves * kWave), 0,
                c, (const uint8_t*)g.a->data, (const float*)g.as->data,
                (const uint16_t*)g.bs->data, (uint16_t*)g.y->data,
                (uint32_t)g.M, (uint32_t)g.K, (uint32_t)g.N,
                (uint32_t)g.a_ld, (uint32_t)g.sa_ld);
            return rc == RAD_OK && hipGetLastError() == hipSuccess ? RAD_OK : R4D_NO(RAD_E_DEVICE);
        }
    }
@@ end
