# libr3 (VTP37): serve the rotated 4-bit table row at M 17..64 with
# ordinary 16-token WMMA launches. Every dispatch retains its own chain
# record and completion count under the AQL backend. The gfx12 source
# and all other IQR weight forms remain unchanged.

@@ find 1
constexpr uint32_t kWave = 32, kBlock = 128, kFK = 256;
@@ replace
constexpr uint32_t kWave = 32, kBlock = 128, kFK = 256;
/* One NT1 WMMA token tile; shared by the kernel, launcher and row slicing. */
constexpr uint32_t kIqrTokenTile = 16u;
@@ end

@@ find 1
        tok[j] = min(j * 16u + frag_c(lane), M - 1u);
@@ replace
        tok[j] = min(j * kIqrTokenTile + frag_c(lane), M - 1u);
@@ end

@@ find 1
            const uint32_t col = j * 16u + frag_c(lane);
@@ replace
            const uint32_t col = j * kIqrTokenTile + frag_c(lane);
@@ end

@@ find 1
    const uint32_t nt = (M + 15u) / 16u;
@@ replace
    const uint32_t nt = (M + kIqrTokenTile - 1u) / kIqrTokenTile;
@@ end

@@ find 1
    if (M <= (tiles_form<F>() ? 64u : 16u) && ((uintptr_t)g.y->data & 15u) == 0u)
        return m16_launch<F>(g, stream);
    /* At most eight waves a block: each has its own transpose tile in LDS. The wave count changes
@@ replace
    if (M <= (tiles_form<F>() ? 64u : kIqrTokenTile) && ((uintptr_t)g.y->data & 15u) == 0u)
        return m16_launch<F>(g, stream);
    /* Only the rotated B4 table + BF16 scale route is numerically qualified.
     * An aligned output stays aligned when advanced by a token row (N is a multiple
     * of 16). Each ordinary R4D_EMIT below gets its own AQL chain record/target;
     * the next one waits on all blocks of its predecessor, including the previous
     * token slice. No split-K scratch or finisher is used on this route. */
    if constexpr (F::KIND == kTable && F::B == 4u && F::LV == 0u &&
                  F::L == 0u && F::LRB == 0u && F::SC == kBf16) {
        if (M > kIqrTokenTile && M <= 64u && g.rotated && ((uintptr_t)g.y->data & 15u) == 0u) {
            RadTensor act = *g.a, scale = *g.as, out = *g.y;
            Operands part = g;
            part.a = &act;
            part.as = &scale;
            part.y = &out;
            for (uint32_t row = 0; row < M; row += kIqrTokenTile) {
                const uint32_t rows = std::min(kIqrTokenTile, M - row);
                act.data = (void*)((const uint8_t*)g.a->data + (size_t)row * g.a_ld);
                scale.data = (void*)((const float*)g.as->data + (size_t)row * g.sa_ld);
                out.data = (void*)((uint16_t*)g.y->data + (size_t)row * N);
                act.shape[0] = rows;
                scale.shape[0] = rows;
                out.shape[0] = rows;
                part.M = rows;
                const int rc = m16_launch<F>(part, stream);
                if (rc != RAD_OK) return rc;
            }
            return RAD_OK;
        }
    }
    /* At most eight waves a block: each has its own transpose tile in LDS. The wave count changes
@@ end

@@ find 1
    if (M < 1 || N < 1 || K < 1 || M > 64) return 0;
    uint32_t ck = 0;
@@ replace
    if (M < 1 || N < 1 || K < 1 || M > 64) return 0;
    /* The slice route has no split-K scratch. If a rare caller passes a
     * misaligned output, m64_launch falls back to the ordinary narrow kernel
     * with ksplit=1, also correct without scratch. */
    const RadTensor* const wt = r4d_opt(a, 2);
    if (M > kIqrTokenTile && wt) {
        const Form f = form(wt->dtype & kWordMask);
        if (f.kind == kTable && f.bits == 4u && f.lv == 0u &&
            f.L == 0u && f.lrb == 0u && f.scale == kBf16 &&
            r4d_gets(a, "dtype") && std::strcmp(r4d_gets(a, "dtype"), "i8a8h") == 0)
            return 0;
    }
    uint32_t ck = 0;
@@ end

# DFlash2 uses the i8a8h rotated input. Weight layout's IQR kernel word
# does not encode that transform, so check the operation's declared dtype,
# not Form::rot (which stays zero for GEMM).
@@ find 1
#include <algorithm>
#include <cstdio>
@@ replace
#include <algorithm>
#include <cstdio>
#include <cstring>
@@ end

@@ find 1
    bool chain;   /* the row's `chain` parameter: the chained forms (r4d_chain.h) */
@@ replace
    bool chain;   /* the row's `chain` parameter: the chained forms (r4d_chain.h) */
    bool rotated = false; /* i8a8h operation; not encoded in the IQR GEMM word */
@@ end

@@ find 1
    g->chain = r4d_geti_or(a, "chain", 0) != 0;
@@ replace
    g->chain = r4d_geti_or(a, "chain", 0) != 0;
    const char* const dtype = r4d_gets(a, "dtype");
    g->rotated = dtype && std::strcmp(dtype, "i8a8h") == 0;
@@ end

# Native fragments and accumulate-once for the 16-row tile on gfx1100. Where the form/NT/chain record
# qualifies (kNative) the token rows load as their 16 K bytes in natural order (the same address in lane
# and lane + 16), the weight rows read back from the wave's LDS tile in the same order, and the int32
# sum of a 128-K scale group stays in the gfx11 layout until the float fold: no operand exchange at all.
# The other specialisations keep the compatibility form (eight bytes a step, as before).
@@ find 1
    static_assert(!GATED || NT == 1u, "the gated form serves one token tile");
@@ replace
    static_assert(!GATED || NT == 1u, "the gated form serves one token tile");
    // A few trellis-MAD forms lose a wave or spill at larger live token tiles: select only the
    // form/NT/chain specialisations with a qualified resource record.
    constexpr bool kNative =
        F::KIND != kTrellisMad ||
        (NT <= 4u && (NT <= 2u || CH::on) && !(F::SC == kRowF32 && F::B == 3u && NT == 1u && CH::on) &&
         !(F::B == 6u && GATED && !CH::on));
@@ end

@@ find 1
        xrow[j] = X + (size_t)tok[j] * x_ld + frag_k0(lane);
@@ replace
        xrow[j] = X + (size_t)tok[j] * x_ld;
@@ end

@@ find 1
    auto bload = [&](uint32_t j, uint32_t kb, i2v (&b)[8], bool live) {
#pragma unroll
        for (uint32_t ks = 0; ks < 8; ++ks) {
            const uint2 v = live ? *(const uint2*)(xrow[j] + kb * kBlock + ks * kK)
                                 : make_uint2(0u, 0u);
            b[ks][0] = (int)v.x;
            b[ks][1] = (int)v.y;
        }
    };
@@ replace
    auto bload = [&](uint32_t j, uint32_t kb, r3_i4 (&b)[8], bool live) {
#pragma unroll
        for (uint32_t ks = 0; ks < 8; ++ks) {
            if constexpr (kNative) {
                const uint4 v = live ? *(const uint4*)(xrow[j] + kb * kBlock + ks * kK)
                                     : make_uint4(0u, 0u, 0u, 0u);
                b[ks] = r3_i4{(int)v.x, (int)v.y, (int)v.z, (int)v.w};
            } else {
                // the compatibility form: this half-wave's eight bytes, as before
                const uint2 v = live ? *(const uint2*)(xrow[j] + kb * kBlock + ks * kK + frag_k0(lane))
                                     : make_uint2(0u, 0u);
                b[ks] = r3_i4{(int)v.x, (int)v.y, 0, 0};
            }
        }
    };
@@ end

@@ find 1
    i2v bc[8], bn[8], bq[2][8];
@@ replace
    r3_i4 bc[8], bn[8], bq[(kNative && NT > 2u) ? 1u : 2u][8];
@@ end

@@ find 1
        Stage8 a8[2];
        frag(w, tr, lane, a8);
        float wsr[8];   /* the lane's eight rows' (row, block) scales, where the form has them */
@@ replace
        Stage8 a8[2];
        frag(w, tr, lane, a8);
        r3_i4 a11[8];
        if constexpr (kNative && NT <= 2u) {
            // the unit's tile rows in natural K order: this lane's row, 16 bytes a step
            const uint8_t* arow = tr + (lane & 15u) * kTrPitch;
#pragma unroll
            for (uint32_t ks = 0; ks < 8; ++ks) {
                const uint2 g0 = *(const uint2*)(arow + ks * 16u), g1 = *(const uint2*)(arow + ks * 16u + 8u);
                a11[ks] = r3_i4{(int)g0.x, (int)g0.y, (int)g1.x, (int)g1.y};
            }
            __builtin_amdgcn_fence(__ATOMIC_RELEASE, "wavefront", "local");
            __builtin_amdgcn_wave_barrier();
            __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "wavefront", "local");
        }
        float wsr[8];   /* the lane's eight rows' (row, block) scales, where the form has them */
@@ end

@@ find 1
            f8v raw = rb_first<BIAS ? 32 : 0>();
#pragma unroll
            for (uint32_t ks = 0; ks < kBlock / kK; ++ks)
                raw = mma8<true>(frag_of(a8[ks / 4u], ks % 4u), bq[j & 1u][ks], raw);
            const float as = XS[(size_t)tok[j] * xs_ld + kb];
@@ replace
            f8v raw;
            if constexpr (kNative) {
                r3_i8 raw11 = __builtin_bit_cast(r3_i8, rb_first<BIAS ? 32 : 0>());
#pragma unroll
                for (uint32_t ks = 0; ks < kBlock / kK; ++ks) {
                    r3_i4 ar;
                    if constexpr (NT > 2u) {
                        const uint8_t* arow = tr + (lane & 15u) * kTrPitch;
                        const uint2 g0 = *(const uint2*)(arow + ks * 16u);
                        const uint2 g1 = *(const uint2*)(arow + ks * 16u + 8u);
                        ar = r3_i4{(int)g0.x, (int)g0.y, (int)g1.x, (int)g1.y};
                    } else {
                        ar = a11[ks];
                    }
                    raw11 = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(
                        true, ar, true, bq[(NT > 2u) ? 0u : (j & 1u)][ks], raw11, false);
                }
                raw = __builtin_bit_cast(f8v, r3_acc_i32_11_to_12(raw11, lane));
            } else {
                raw = rb_first<BIAS ? 32 : 0>();
#pragma unroll
                for (uint32_t ks = 0; ks < kBlock / kK; ++ks) {
                    // the gfx12 half-fragment of the lane's half-wave from the natural 16 bytes
                    const r3_i4 nb = bq[j & 1u][ks];
                    i2v bh;
                    bh[0] = nb.x;
                    bh[1] = nb.y;
                    raw = mma8<true>(frag_of(a8[ks / 4u], ks % 4u), bh, raw);
                }
            }
            const float as = XS[(size_t)tok[j] * xs_ld + kb];
@@ end

# The native token fragments are 16 bytes a step, so the next unit's ring would double: the native form
# loads a unit's fragments as it starts it (other warps hide the latency), the compatibility form keeps its ring.
@@ find 1
    bload(0u, wave, bc, wave < c.nkb);
@@ replace
    if constexpr (!kNative) bload(0u, wave, bc, wave < c.nkb);
@@ end

