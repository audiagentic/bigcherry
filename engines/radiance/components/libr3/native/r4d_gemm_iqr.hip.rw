@@ replace
    static_assert(!GATED || NT == 1u, "the gated form serves one token tile");
    // A few trellis-MAD forms lose a wave or spill at larger live token tiles: select only the
    // form/NT/chain specialisations with a qualified resource record.
    constexpr bool kNative =
        F::KIND != kTrellisMad ||
        (NT <= 4u && (NT <= 2u || CH::on) && !(F::SC == kRowF32 && F::B == 3u && NT == 1u && CH::on) &&
         !(F::B == 6u && GATED && !CH::on));
@@ end

