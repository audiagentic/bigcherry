# Scratch experiment: for long native token tiles, reuse one B register plane.
@@ find 1
            if (j + 1u < NT) bload(j + 1u, kb, bq[(j + 1u) & 1u], true);
@@ replace
            if constexpr (kNative && NT > 2u)
                bload(j, kb, bq[0], true);
            else if (j + 1u < NT)
