            RadTensor act = *g.a, scale = *g.as, out = *g.y;
            Operands part = g;
            part.a = &act;
            part.as = &scale;
            part.y = &out;
            for (uint32_t row = 0; row < M; row += kIqrTokenTile) {
                const uint32_t rows = std::min(kIqrTokenTile, M - row);
                act.data = (void*)((const uint8_t*)g.a->data + (size_t)row * g.a_ld);
                scale.data = (void*)((const float*)g.as->data + (size_t)row * g.sa_ld);
                out.data = (void*)((uint16_t*)g.y->data + (size_t)row * N);
                act.shape[0] = rows;
                scale.shape[0] = rows;
                out.shape[0] = rows;
                part.M = rows;
                const int rc = m16_launch<F>(part, stream);
                if (rc != RAD_OK) return rc;
            }
            return RAD_OK;
