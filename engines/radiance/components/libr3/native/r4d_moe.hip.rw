        auto kstep = [&](uint32_t ks, f8v& acc, bool fresh = false) {
            if (r3n) {
                const r3_v16bf af = r3_row16_e4m3_to_bf16(
                    s_a + (size_t)(lane & 15u) * lds_pitch<FK>() + ks);
                const r3_v16bf bf = r3_row16_e4m3_to_bf16(
                    s_b + (size_t)(wave * 16 + (lane & 15u)) * lds_pitch<FK>() + ks);
                acc = r3_wmma_bf16_native(af, bf, fresh ? acc_zero() : acc);
            } else {
                const i2v af = frag<FK>(s_a, 0, ks, lane);
                const i2v bf = frag<FK>(s_b, wave * 16, ks, lane);
                acc = mma(af, bf, fresh ? acc_zero() : acc);
            }
        };
@@ end

