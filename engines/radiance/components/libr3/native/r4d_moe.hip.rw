# Native gfx11 w4nl64a8h MoE inner loop for libr3.
#
# Pinned 1.3.0 does not feed int8 activations to this row: Aq is RAD_F8E4M3 and w4nl64a8h expands its nonlinear
# nibble codebook to exact E4M3 bytes before WMMA. The compatibility form widens each 8-byte gfx12 fragment to
# bf16, exchanges the partner half into a gfx11 row, runs gfx11 bf16 WMMA with C=0, then exchanges the product back
# and adds the caller accumulator on every K step. R3_MOE_NATIVE=1 keeps full 16-code rows and the accumulator in
# gfx11 ownership through each scale group, converting the accumulator once before the unchanged scale fold.
# IU8 is deliberately not used: doing so would require requantising the E4M3 activation/codebook product and would
# no longer be the pinned kernel's bit-for-bit arithmetic.
#
# mode bit 7 is libr3-private; upstream uses bit 0, bits 1-2 and bits 8+ only.
@@ find 1
    /* `mode`: bit 0 `a_sorted`, bits 1-2 the class shift (1 for two classes, 2 for four), bits
     * 8 up `parts`. */
    const uint32_t a_sorted = mode & 1u, cshift = (mode >> 1) & 3u, parts = mode >> 8;
@@ replace
    /* libr3 mode bit 7 selects native gfx11 ownership for w4nl64a8h only. */
    const uint32_t a_sorted = mode & 1u, cshift = (mode >> 1) & 3u, parts = mode >> 8;
    const bool r3n = W4 == 2 && (mode & 0x80u) != 0;
@@ end

