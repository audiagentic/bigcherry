            auto kstep = [&](uint32_t ks, f8v (&acc)[WM][WN], bool fresh = false) {
                if (r3n) {
                    r3_v16bf af[WM], bf[WN];
#pragma unroll
                    for (uint32_t i = 0; i < WM; ++i) {
                        if (SK && r0 + (wgm * WM + i) * 16 >= re) continue;
                        af[i] = r3_row16_e4m3_to_bf16(
                            s_a + (size_t)((wgm * WM + i) * 16 + (lane & 15u)) * lds_pitch<FK>() + ks);
                    }
#pragma unroll
                    for (uint32_t j = 0; j < WN; ++j)
                        bf[j] = r3_row16_e4m3_to_bf16(
                            s_b + (size_t)((wgn * WN + j) * 16 + (lane & 15u)) * lds_pitch<FK>() + ks);
#pragma unroll
                    for (uint32_t i = 0; i < WM; ++i) {
                        if (SK && r0 + (wgm * WM + i) * 16 >= re) continue;
#pragma unroll
                        for (uint32_t j = 0; j < WN; ++j)
