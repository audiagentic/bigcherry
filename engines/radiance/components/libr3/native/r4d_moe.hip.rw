@@ find 1
    const uint32_t mode = (a_sorted ? 1u : 0u) | (cshift << 1) | ((uint32_t)parts << 8);
@@ replace
    const char* r3_moe = std::getenv("R3_MOE_NATIVE");
    const bool r3_native = W4 == 2 && r3_moe && std::atoi(r3_moe) != 0;
    const uint32_t mode = (a_sorted ? 1u : 0u) | (cshift << 1) | (r3_native ? 0x80u : 0u)
                        | ((uint32_t)parts << 8);
@@ end


# The sorted down-projection has its own decode kernel. The production M=1/few-row path takes it,
# so R3_MOE_NATIVE must carry the same native ownership through that kernel too.
@@ find 1
    const uint32_t cshift = (mode >> 1) & 3u, parts = mode >> 8;

    __shared__ uint8_t  s_a[FM * lds_pitch<FK>()];
@@ replace
    const uint32_t cshift = (mode >> 1) & 3u, parts = mode >> 8;
    const bool r3n = W4 == 2 && (mode & 0x80u) != 0; /* down-decode */

    __shared__ uint8_t  s_a[FM * lds_pitch<FK>()];
@@ end

