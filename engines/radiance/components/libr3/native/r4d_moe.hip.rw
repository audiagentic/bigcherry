                        if (SK && r0 + (wgm * WM + i) * 16 >= re) continue;
#pragma unroll
                        for (uint32_t j = 0; j < WN; ++j)
                            acc[i][j] = mma(af[i], bf[j], fresh ? acc_zero() : acc[i][j]);
                    }
                }
            };
@@ end

