# Native gfx11 form of r4d_gemm_mxfp4a8_tiled, the MXFP4 GEMM for prefill row counts (RR08), for radiance 1.13.0's
# shape (a shared device body; the plain kernel owns its LDS, the two-body kernel passes its own).
#
# libr4d: the activation is re-tiled once into the op's scratch in gfx12 fragment order (per 16-row fragment and
# K step, 32 slots of 8 E4M3 bytes); the weight slab is unpacked to E4M3 in shared memory; a lane reads 8 bytes of
# each operand and calls the gfx12 fp8 WMMA.
#
# Native:
#   - the activation re-tile keeps libr4d's E4M3 slab (gemm_wpa8i8_tiled reads it as E4M3 fragments from the same
#     scratch) and the tile kernel ALSO writes a bf16 slab after it, in gfx11 fragment rows (per fragment and K step, 16 rows
#     of 16 bf16, 32 bytes a row), so an activation fragment here is one 32-byte load and nothing is widened in the K loop.
#     The scratch is 3x the E4M3 slab (1 + 2), from the same hook for both users.
#   - the weight slab is staged as bf16, straight from the 4-bit codes by table lookup (r3_mxfp4_store8_bf16), in
#     both LDS arrays (the body's own and the two-body kernel's).
#   - the gfx11 bf16 WMMA takes the accumulator as its C operand; the accumulator stays in the gfx11 layout through
#     the K loop (the boundary rescale is per column, the same in both layouts) and is moved to the gfx12 layout
#     once, in front of the unchanged epilogue.
#   - the activation fragments are loaded in the step that uses them, not a whole slab ahead: a gfx11 fragment is 8
#     dwords, and TM x NS of them at once would not fit a wave's registers.

@@ find 1
  mxt_u2 v = { 0u, 0u };
  if (r < M) v = *(const mxt_u2*)(A + (size_t)r * lda + k);
  *(mxt_u2*)(AT + o * 8) = v;
@@ replace
  mxt_u2 v = { 0u, 0u };
  if (r < M) v = *(const mxt_u2*)(A + (size_t)r * lda + k);
  *(mxt_u2*)(AT + o * 8) = v;
  // libr3 native: the same 8 values, widened, as a gfx11 bf16 fragment row after the E4M3 slab
  r3_store8_e4m3_as_bf16((unsigned short*)(AT + (long long)((M + 15) / 16) * 16 * K + f * 512 + (long long)(lane & 15) * 32 +
                                           (lane >> 4) * 16), v[0], v[1]);
@@ end

@@ find 1
  return M < 1 || K < 16 ? 0 : (long)((M + 15) / 16) * 16 * K;
@@ replace
  return M < 1 || K < 16 ? 0 : (long)((M + 15) / 16) * 16 * K * 3;  // libr3 native: the E4M3 slab, then a bf16 slab
@@ end

@@ find 1
    int M, int K, int N, int as_rs, int ldws, int ldc, unsigned char* __restrict__ sW_in,
@@ replace
    int M, int K, int N, int as_rs, int ldws, int ldc, unsigned short* __restrict__ sW_in,  // libr3 native: bf16
@@ end

@@ find 1
  __shared__ unsigned char sW_own[OWN ? BNF * STR : 1];
@@ replace
  __shared__ unsigned short sW_own[OWN ? BNF * STR : 1];  // libr3 native: bf16
@@ end

@@ find 1
  unsigned char* __restrict__ sW = OWN ? sW_own : sW_in;
@@ replace
  unsigned short* __restrict__ sW = OWN ? sW_own : sW_in;
@@ end

@@ find 1
  __shared__ unsigned char sW[BNF * STR];
  __shared__ unsigned int sMag[32];
  __shared__ float sR[ABLK ? R4D_MXT_BMF : 1];
@@ replace
  __shared__ unsigned short sW[BNF * STR];  // libr3 native: bf16
  __shared__ unsigned int sMag[32];
  __shared__ float sR[ABLK ? R4D_MXT_BMF : 1];
@@ end

@@ find 1
    abase[i] = AT + (size_t)__builtin_amdgcn_readfirstlane(mt * ksteps * 256);
  }
  const unsigned int aoff = (unsigned int)lane * 8;
@@ replace
    abase[i] = AT + (size_t)(((M + 15) / 16) * 16) * K + (size_t)__builtin_amdgcn_readfirstlane(mt * ksteps * 512);
  }
  const unsigned int aoff = (unsigned int)col * 32;  // libr3 native: this lane's row of the bf16 fragment
@@ end

@@ find 1
    // A fragments for the whole slab, one clause, consumed only at the WMMAs.
    mxt_v2i af[TM][NS];
#pragma unroll
    for (int i = 0; i < TM; ++i)
#pragma unroll
      for (int st = 0; st < NS; ++st)
        af[i][st] = *(const mxt_v2i*)(abase[i] +
                                      (aoff + (unsigned int)(k0 * 16) + (unsigned int)(st * 256)));
@@ replace
    // libr3 native: the activation fragments are loaded in the step that uses them (below)
@@ end

@@ find 1
        unsigned int lo, hi;
        r4d_mxfp4_unpack8_t(wqn[it][q], sMag[d * 2], sMag[d * 2 + 1], &lo, &hi);
        *(mxt_u2*)(&sW[(wrow[it] + q) * STR + wkloc[it]]) = mxt_u2{lo, hi};
@@ replace
        r3_mxfp4_store8_bf16(&sW[(wrow[it] + q) * STR + wkloc[it]], wqn[it][q], d);  // libr3 native
@@ end

@@ find 1
      const int kk = step * 16 + kb8;
      mxt_v2i wf[TN];
#pragma unroll
      for (int j = 0; j < TN; ++j) {
        const unsigned char* p = &sW[(wn * TN * 16 + j * 16 + col) * STR + kk];
        wf[j][0] = *(const int*)p; wf[j][1] = *(const int*)(p + 4);
      }
@@ replace
      const int kk = step * 16;  // libr3 native: the row's 16 values, in every lane
      r3_v16bf wf[TN];
#pragma unroll
      for (int j = 0; j < TN; ++j) wf[j] = r3_row16_e4m3_to_bf16(&sW[(wn * TN * 16 + j * 16 + col) * STR + kk]);
@@ end

@@ find 1
        if (PART && i >= live) break;   // wave-uniform: padding fragments past M
#pragma unroll
        for (int j = 0; j < TN; ++j)
          acc[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(wf[j], af[i][step],
                                                                          acc[i][j]);
@@ replace
        if (PART && i >= live) break;   // wave-uniform: padding fragments past M
        const r3_v16bf af = r3_ld16_bf16(abase[i] + (aoff + (unsigned int)(k0 * 32) + (unsigned int)(step * 512)));
#pragma unroll
        for (int j = 0; j < TN; ++j) acc[i][j] = r3_wmma_bf16_native(wf[j], af, acc[i][j]);
@@ end

@@ find 1
  // Epilogue. A lane holds row m0 + 64*wm + 16i + col of M fragment i and eight consecutive columns
@@ replace
#pragma unroll
  for (int i = 0; i < TM; ++i)
#pragma unroll
    for (int j = 0; j < TN; ++j) acc[i][j] = r3_acc_native_to_gfx12(acc[i][j]);  // libr3 native: once
  // Epilogue. A lane holds row m0 + 64*wm + 16i + col of M fragment i and eight consecutive columns
@@ end

# RR08: expose the libr3-owned lane-owned gfx11 form in this rewritten unit.
@@ find 1
#include "r4d_mxfp4.h"
@@ replace
#include "r4d_mxfp4.h"
#include "r3_mxfp4_bt.h"
@@ end

# Default off. Both arms use the same upstream row, operands, layout hooks and op scratch.
@@ find 1
    for (int p = 0; p < mp.n; ++p) {
        const long long n0 = mp.n0[p], np = mp.n1[p] - mp.n0[p];
        R4D_TRY("gemm_mxfp4a8_tiled",
            r4d_mxfp4a8_tile_a(r4d_addr(g.a) + p * g.K, at, (int)g.M, (int)g.K,
                               (long)(uintptr_t)s, (int)(mp.lda ? mp.lda : g.K));
            r4d_gemm_mxfp4a8_tiled(at, r4d_addr(g.ascale) + p * kb * 4, r4d_addr(g.b) + n0 * g.K / 2,
                                   r4d_addr(g.bscale) + n0, r4d_addr(g.bref) + n0,
                                   r4d_addr(g.y) + n0 * 2, (int)g.M, (int)g.K, (int)np, t.tn,
                                   as_group, as_rs, (long)(uintptr_t)s, (int)g.N, (int)g.N));
    }
@@ replace
    const int r3_mode=r3_bt_mode();
    for (int p = 0; p < mp.n; ++p) {
        const long long n0 = mp.n0[p], np = mp.n1[p] - mp.n0[p];
        const int lda = (int)(mp.lda ? mp.lda : g.K);
        if (r3_mode == 1) {
            R4D_TRY("gemm_mxfp4a8_bt_gfx11",
                r3_mxfp4_bt_prepare(r4d_addr(g.a) + p * g.K, at, (int)g.M, (int)g.K, lda,
                                    (long)(uintptr_t)s);
                r3_mxfp4_bt_launch(at, r4d_addr(g.ascale) + p * kb * 4, r4d_addr(g.b) + n0 * g.K / 2,
                                   r4d_addr(g.bscale) + n0, r4d_addr(g.bref) + n0,
                                   r4d_addr(g.y) + n0 * 2, (int)g.M, (int)g.K, (int)np,
                                   as_group, as_rs, (long)(uintptr_t)s, (int)g.N, (int)g.N));
        } else if (r3_mode == 2) {
            R4D_TRY("gemm_mxfp4a8_bt2_gfx11",
                r3_mxfp4_bt_prepare(r4d_addr(g.a) + p * g.K, at, (int)g.M, (int)g.K, lda,
                                    (long)(uintptr_t)s);
                r3_mxfp4_bt2_launch(at, r4d_addr(g.ascale) + p * kb * 4, r4d_addr(g.b) + n0 * g.K / 2,
                                    r4d_addr(g.bscale) + n0, r4d_addr(g.bref) + n0,
                                    r4d_addr(g.y) + n0 * 2, (int)g.M, (int)g.K, (int)np,
                                    as_group, as_rs, (long)(uintptr_t)s, (int)g.N, (int)g.N));
        } else {
            R4D_TRY("gemm_mxfp4a8_tiled",
                r4d_mxfp4a8_tile_a(r4d_addr(g.a) + p * g.K, at, (int)g.M, (int)g.K,
                                   (long)(uintptr_t)s, lda);
                r4d_gemm_mxfp4a8_tiled(at, r4d_addr(g.ascale) + p * kb * 4, r4d_addr(g.b) + n0 * g.K / 2,
                                       r4d_addr(g.bscale) + n0, r4d_addr(g.bref) + n0,
                                       r4d_addr(g.y) + n0 * 2, (int)g.M, (int)g.K, (int)np, t.tn,
                                       as_group, as_rs, (long)(uintptr_t)s, (int)g.N, (int)g.N));
        }
    }
@@ end
