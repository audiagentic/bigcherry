# R3_HC_NATIVE: gfx1100 E4M3 decode for the one/small-row hc_read path.
# Pinned 1.3.0's gfx11 compatibility path decodes every E4M3 code through scalar software.
# Finite E4M3 values are exactly representable in bf16/f32; this selects an integer bit-decode
# while preserving the original FMA order, scale folds, reductions, and two-kernel launch split.
@@ find 1
__device__ __forceinline__ void e4m3x8(uint32_t lo, uint32_t hi, float* f) {
    const v2f a = __builtin_amdgcn_cvt_pk_f32_fp8((int)lo, false);
    const v2f b = __builtin_amdgcn_cvt_pk_f32_fp8((int)lo, true);
    const v2f c = __builtin_amdgcn_cvt_pk_f32_fp8((int)hi, false);
    const v2f d = __builtin_amdgcn_cvt_pk_f32_fp8((int)hi, true);
    f[0] = a.x; f[1] = a.y; f[2] = b.x; f[3] = b.y;
    f[4] = c.x; f[5] = c.y; f[6] = d.x; f[7] = d.y;
}
@@ replace
__device__ __forceinline__ void e4m3x8(uint32_t lo, uint32_t hi, float* f) {
    const v2f a = __builtin_amdgcn_cvt_pk_f32_fp8((int)lo, false);
    const v2f b = __builtin_amdgcn_cvt_pk_f32_fp8((int)lo, true);
    const v2f c = __builtin_amdgcn_cvt_pk_f32_fp8((int)hi, false);
    const v2f d = __builtin_amdgcn_cvt_pk_f32_fp8((int)hi, true);
    f[0] = a.x; f[1] = a.y; f[2] = b.x; f[3] = b.y;
    f[4] = c.x; f[5] = c.y; f[6] = d.x; f[7] = d.y;
}
template <bool R3N>
__device__ __forceinline__ void r3_hc_e4m3x8(uint32_t lo, uint32_t hi, float* f) {
    if constexpr (!R3N) {
        e4m3x8(lo, hi, f);
    } else {
        const uint32_t w[2] = {lo, hi};
#pragma unroll
        for (int d = 0; d < 2; ++d)
#pragma unroll
            for (int b = 0; b < 4; ++b) {
                const uint32_t code = (w[d] >> (8 * b)) & 0xffu;
                f[4 * d + b] = (code & 0x7fu) == 0x7fu
                    ? r3_e4m3_to_f32(code)
                    : __uint_as_float(r3_e4m3_to_bf16_bits(code) << 16);
            }
    }
}
@@ end

@@ find 1
__device__ __forceinline__ float hc8_dot16(const unsigned short* __restrict__ sv, uint4 c) {
    float wf[16], nf[16];
    e4m3x8(c.x, c.y, wf);
    e4m3x8(c.z, c.w, wf + 8);
@@ replace
template <bool R3N = false>
__device__ __forceinline__ float hc8_dot16(const unsigned short* __restrict__ sv, uint4 c) {
    float wf[16], nf[16];
    r3_hc_e4m3x8<R3N>(c.x, c.y, wf);
    r3_hc_e4m3x8<R3N>(c.z, c.w, wf + 8);
@@ end

