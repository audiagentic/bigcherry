#if ABL != 4
            if (doP[i]) p[i] = r3_gdn_wmma_native_compat(pknN(i, ko), aq, p[i]);
#endif
          }
        } else {
          const v8bf ak = pkmf(ko), aq = pqf(ko);
#pragma unroll
