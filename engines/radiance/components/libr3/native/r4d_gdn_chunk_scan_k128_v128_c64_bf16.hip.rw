__global__ __launch_bounds__(NTHR) void r4d_gdn_chunk_scan_kernel(
@@ replace
template <int SDT, bool H0 = true, bool HT = true, bool R3N = false>
__global__ __launch_bounds__(NTHR) void r4d_gdn_chunk_scan_kernel(
@@ end

@@ find 1
