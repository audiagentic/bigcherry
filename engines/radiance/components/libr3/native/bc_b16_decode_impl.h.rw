                    #pragma unroll
                    for (int j = 0; j < PF; ++j) acc[g + j] = D::wmma(vb[j], p16, acc[g + j]);
                }
@@ replace
                    if (SGB) sched_barrier();
                    #pragma unroll
                    for (int j = 0; j < PF; ++j) {
                        if constexpr (R3_ACC_ONCE) acc[g + j] += r3_product11(vb[j], p16);
                        else acc[g + j] = D::wmma(vb[j], p16, acc[g + j]);
                    }
                }
@@ end

@@ find 1
    if (!live) return;
    // fetch-inactive: the f32 partials read lrow under `if (h == 0)` only (see the prefill kernel's
    // epilogue).
    const float lrow = l_i + swap16_fi(l_i);
@@ replace
    if (!live) return;
    // The softmax rescale's alpha is the same for lane ^ 16 (the same key
    // row's m_ref and rmax), so its per-element f32 multiply commutes with
    // this permutation; every element preserves its exact operation order.
    if constexpr (R3_ACC_ONCE) {
        #pragma unroll
        for (int dt = 0; dt < NKS; ++dt) acc[dt] = r3_acc_native_to_gfx12(acc[dt]);
    }
    // fetch-inactive: the f32 partials read lrow under `if (h == 0)` only (see the prefill kernel's
    // epilogue).
    const float lrow = l_i + swap16_fi(l_i);
@@ end
