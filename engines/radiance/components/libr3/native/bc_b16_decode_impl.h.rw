# gfx1100: decode attention keeps the gfx12 shim's zero-C WMMA product and its
# elementwise f32-add sequence, accumulating in the gfx11 layout. Convert QK
# immediately before softmax and PV once at the segment partial store.
# Compile-time restrict to the reachable fp8 h256/gqa6/bs16/f16 form; this
# shared decode body is also instantiated by other attention geometries.

@@ find 1
    constexpr int TREE  = (OPT & O_TREE)  ? 1 : 0;
    typedef DT16<F16> D;
    typedef typename D::frag frag16;
@@ replace
    constexpr int TREE  = (OPT & O_TREE)  ? 1 : 0;
    typedef DT16<F16> D;
    typedef typename D::frag frag16;
    // Other instantiations retain their original gfx12-compat WMMA path.
    constexpr bool R3_ACC_ONCE = HEAD_DIM == 256 && GQA == 6 && BS == 16 &&
                                 TILE == 16 && !KVP && F16 && WIN == 0 &&
                                 Layout == RAD_KVQ_NONE && OPT == 3429947;
@@ end

@@ find 1
    if constexpr (K6 || KI) __builtin_assume(tid < NTHR);
    const int c = lane & 15, h = lane >> 4;

    const int sp = blockIdx.x, kvh = blockIdx.y, seq = blockIdx.z;
@@ replace
    if constexpr (K6 || KI) __builtin_assume(tid < NTHR);
    const int c = lane & 15, h = lane >> 4;

    // The shim's zero-C gfx11 product, before its gfx12 accumulator shuffle.
    // Never pass a running accumulator as WMMA C: that would alter fp32 bits.
    auto r3_product11 = [&](frag16 a, frag16 b) {
        const r3_v16h a11 = __builtin_bit_cast(r3_v16h,
            r3_frag_12_to_11(__builtin_bit_cast(r3_u4, a), lane));
        const r3_v16h b11 = __builtin_bit_cast(r3_v16h,
            r3_frag_12_to_11(__builtin_bit_cast(r3_u4, b), lane));
        const r3_v8f zero = {0,0,0,0,0,0,0,0};
        return r3_wmma_f16_native(a11, b11, zero);
    };

    const int sp = blockIdx.x, kvh = blockIdx.y, seq = blockIdx.z;
@@ end

@@ find 1
                if (SGB) sched_barrier();
                #pragma unroll
                for (int j = 0; j < PF; ++j) s = D::wmma(kb[j], qf[g + j], s);
            }
            float sc[8];
@@ replace
                if (SGB) sched_barrier();
                #pragma unroll
                for (int j = 0; j < PF; ++j) {
                    if constexpr (R3_ACC_ONCE) s += r3_product11(kb[j], qf[g + j]);
                    else s = D::wmma(kb[j], qf[g + j], s);
                }
            }
            if constexpr (R3_ACC_ONCE) s = r3_acc_native_to_gfx12(s);
            float sc[8];
@@ end

@@ find 1
