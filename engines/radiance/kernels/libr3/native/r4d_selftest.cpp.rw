# radiance's selftest has no MXFP4 decode case with one activation row, which is the case libr3's vector kernel
# (r3_mxfp4_gemv.h) serves. Add them beside the first decode case: both activation scale grids, an N that is not a
# multiple of the 128-column block, and the 27B's deepest K.
@@ find 1
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 8, 272, 640, 0, false);
@@ replace
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 8, 272, 640, 0, false);
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 1, 272, 640, 0, false);   // libr3: M = 1
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 1, 272, 640, 0, true);
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 1, 400, 2560, 0, true);
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 1, 5120, 17408, 0, false);
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 3, 272, 640, 0, true);    // libr3: the 4-row strip
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 16, 400, 2560, 0, true);  // libr3: a full 16-row fragment
        mxfp4a8_numeric(pl, "gemm_mxfp4a8_decode", 4, 5120, 6144, 0, false);
@@ end


# RR08 full host-reference oracle, opt-in because the production-shape matrix is deliberately large.
# Same built plugin: R3_BT=0 checks tiled, R3_BT=1 the direct form, R3_BT=2 the LDS-shared form.
@@ find 1
        /* K not a multiple of 128: the TN=2 kernel takes the 64-wide slab. */
@@ replace
        if (std::getenv("R3_BT_ORACLE") && std::atoi(std::getenv("R3_BT_ORACLE")) != 0) {
            struct R3MxPfShape { int N, K; };
            const R3MxPfShape r3_shapes[] = {
                {34816, 5120}, {5120, 17408}, {16384, 5120}, {5120, 6144}, {12288, 5120},
            };
            for (const R3MxPfShape& sh : r3_shapes)
                for (int mm : {64, 128, 512}) {
                    mxfp4a8_numeric(pl, "gemm_mxfp4a8_tiled", mm, sh.N, sh.K, 0, false);
                    mxfp4a8_numeric(pl, "gemm_mxfp4a8_tiled", mm, sh.N, sh.K, 0, true);
                }
        }
        /* K not a multiple of 128: the TN=2 kernel takes the 64-wide slab. */
@@ end


# RR08 prefill timing mode. It uses the MXFP4 row's own layout hooks, rotates codes/E8M0/Wref past cache and
# includes the activation pre-pass in the measured row time. R3_BT selects the old or new implementation.
@@ find 1
static void fp8_perf(const Plugin& pl, int64_t N, int64_t K, int64_t M, int iters) {
@@ replace
static void mxfp4_prefill_perf(const Plugin& pl, int64_t N, int64_t K, int64_t M, int iters) {
    if (N % 16 || K % 64 || M < 1) {
        std::printf("--perfmxfp4: N multiple of 16, K of 64, M >= 1\n");
        return;
    }
    const RadKernelInfo* r = find(pl, "gemm_mxfp4a8_tiled");
    if (!r || !r->layout || !r->relayout) {
        std::printf("--perfmxfp4: gemm_mxfp4a8_tiled row/hooks absent\n");
        return;
    }
    Planes p;
    p.enc = rad_enc_affine(RAD_FP4E2M1, RAD_E8M0, 1, 32);
    p.size(N, K);
    const int ic = p.find("codes"), is = p.find("scale");
    if (ic < 0 || is < 0) { std::printf("--perfmxfp4: encoding planes absent\n"); return; }
    mxfp4_fill(p, ic, is, N, K, 0x81u, false);
    std::vector<RadParam> lp = { PI("N", N), PI("K", K), PI("group", 32) };
    std::vector<uint8_t> wq, ws, wr;
    if (stored(r, lp, 2, p, { "codes" }, &wq) != RAD_OK ||
        stored(r, lp, 3, p, { "scale" }, &ws) != RAD_OK ||
        stored(r, lp, 6, p, { "scale" }, &wr) != RAD_OK) {
        std::printf("--perfmxfp4: relayout failed\n");
        return;
    }

    const size_t one = wq.size() + ws.size() + wr.size();
    int copies = (int)(((size_t)768 << 20) / (one ? one : 1)) + 1;
    if (copies > 64) copies = 64;
    void* d_w = dalloc(wq.size() * (size_t)copies);
    void* d_e = dalloc(ws.size() * (size_t)copies);
    void* d_r = dalloc(wr.size() * (size_t)copies);
    const int64_t asc = (K + 127) / 128;
    void* d_a = dalloc((size_t)M * K);
    void* d_s = dalloc((size_t)M * asc * 4);
    void* d_y = dalloc((size_t)M * N * 2);
    if (!d_w || !d_e || !d_r || !d_a || !d_s || !d_y) {
        std::printf("--perfmxfp4: hipMalloc failed\n");
        return;
    }
    for (int c = 0; c < copies; ++c) {
        st_memcpy((uint8_t*)d_w + (size_t)c*wq.size(), wq.data(), wq.size(), hipMemcpyHostToDevice);
        st_memcpy((uint8_t*)d_e + (size_t)c*ws.size(), ws.data(), ws.size(), hipMemcpyHostToDevice);
        st_memcpy((uint8_t*)d_r + (size_t)c*wr.size(), wr.data(), wr.size(), hipMemcpyHostToDevice);
    }
    std::vector<uint8_t> ha((size_t)M*K, 0x38);
    std::vector<float> hs((size_t)M*asc, 1.0f);
    st_memcpy(d_a, ha.data(), ha.size(), hipMemcpyHostToDevice);
    st_memcpy(d_s, hs.data(), hs.size()*4, hipMemcpyHostToDevice);

    std::vector<RadTensor> ts = {
        T(d_a, RAD_F8E4M3, {M,K}), T(d_s, RAD_F32, {M,asc}),
        T(d_w, RAD_U8, {(int64_t)wq.size()}), T(d_e, RAD_U8, {(int64_t)ws.size()}),
        T(d_y, RAD_BF16, {M,N}), T(nullptr, RAD_F32, {1}),
        T(d_r, RAD_U8, {(int64_t)wr.size()}),
    };
    absent(ts[5]);
    std::vector<RadParam> ps = {
        PI("M",M), PI("N",N), PI("K",K), PI("group",32), PS("dtype","mxfp4a8"),
    };
    RadArgs a;
    std::memset(&a, 0, sizeof(a));
    a.t=ts.data(); a.n_t=(int)ts.size(); a.p=ps.data(); a.n_p=(int)ps.size(); a.world_size=1;
    if (r->scratch) {
        const int64_t need = r->scratch(&a);
        if (need > 0) { a.scratch=dalloc((size_t)need); a.scratch_bytes=need; }
    }
    if (r->launch(&a, nullptr) != RAD_OK || st_stream_sync(nullptr) != hipSuccess) {
        std::printf("--perfmxfp4: warm launch failed\n");
        return;
    }

    hipEvent_t e0,e1;
    st_ev_create(&e0); st_ev_create(&e1); st_ev_record(e0,nullptr);
    for (int i=0;i<iters;++i) {
        const int c=i%copies;
        ts[2].data=(uint8_t*)d_w+(size_t)c*wq.size();
        ts[3].data=(uint8_t*)d_e+(size_t)c*ws.size();
        ts[6].data=(uint8_t*)d_r+(size_t)c*wr.size();
        if (r->launch(&a,nullptr) != RAD_OK) {
            std::printf("--perfmxfp4: timed launch failed\n");
            st_ev_destroy(e0); st_ev_destroy(e1);
            return;
        }
    }
    st_ev_record(e1,nullptr); st_ev_sync(e1);
    float ms=0.f; st_ev_elapsed(&ms,e0,e1); st_ev_destroy(e0); st_ev_destroy(e1);
    const double us=(double)ms*1000.0/iters;
    const double gbps=(double)one/us/1000.0;
    std::printf("\nMXFP4 prefill GEMM N=%lld K=%lld M=%lld %.1f MiB weight, %d copies, %d iters\n",
                (long long)N,(long long)K,(long long)M,(double)one/(1<<20),copies,iters);
    std::printf("  %-22s %9.1f us  %6.1f GB/s\n","gemm_mxfp4a8_tiled",us,gbps);
}

