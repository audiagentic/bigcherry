        else if (perf_mx) mxfp4_prefill_perf(pl, perf_n, perf_k, perf_m, perf_it);
        else if (perf_w8) w8_perf(pl, perf_n, perf_k, perf_m, perf_it);
@@ end

@@ find 1
                "  --perfw8 N K M [iters]:  the 8-bit trunk GEMMs -- block E4M3 W8A8 and the int8\n"
