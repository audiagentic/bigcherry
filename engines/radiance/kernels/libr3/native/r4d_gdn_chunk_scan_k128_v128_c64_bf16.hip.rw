# Native gfx11 GDN chunk scan for libr3.
//
// Radiance's recurrence, shared-memory geometry, masking and state representation are unchanged.
// The rewrite changes only WMMA ownership on gfx11: full 16-value bf16 rows feed native WMMA,
// accumulators stay in gfx11 layout across each contraction loop, and are converted only where
// scalar code or the persistent state/output layout needs gfx12 ordering. This removes the
// compatibility layer's two operand lane exchanges plus accumulator exchange from every WMMA.
// The native instantiation is the default; R3_GDN_NATIVE=0 selects the compatibility one.
//
@@ find 1
#include <hip/hip_runtime.h>
#include "r4d.h"
@@ replace
#include <hip/hip_runtime.h>
#include <cstdlib>
#include "r4d.h"
@@ end

@@ find 1
template <int SDT, bool H0 = true, bool HT = true>
__global__ __launch_bounds__(NTHR) void r4d_gdn_chunk_scan_kernel(
@@ replace
template <int SDT, bool H0 = true, bool HT = true, bool R3N = false>
__global__ __launch_bounds__(NTHR) void r4d_gdn_chunk_scan_kernel(
@@ end

@@ find 1
#if APRE
    v8bf apre[BT / 16];
    {
#if GO
      const unsigned aoh = rowGo((unsigned)ars, mt * 16, lim, lane);
#pragma unroll
      for (int sk = 0; sk < BT / 16; ++sk) apre[sk] = fragGo(ag, aoh + sk * 16);
#else
      const unsigned short* pah = rowG(ag, ars, mt * 16, lim, lane);
#pragma unroll
      for (int sk = 0; sk < BT / 16; ++sk) apre[sk] = fragP(pah + sk * 16);
#endif
    }
#endif
@@ replace
#if APRE
    v8bf apre[BT / 16];
    r3_v16bf apreN[BT / 16];
    {
#if GO
      const unsigned aoh = rowGo((unsigned)ars, mt * 16, lim, lane);
#pragma unroll
      for (int sk = 0; sk < BT / 16; ++sk) {
        if constexpr (R3N) apreN[sk] = r3_gdn_fragGo_native(ag, aoh + sk * 16, lane);
        else               apre[sk]  = fragGo(ag, aoh + sk * 16);
      }
#else
      const unsigned short* pah = rowG(ag, ars, mt * 16, lim, lane);
#pragma unroll
      for (int sk = 0; sk < BT / 16; ++sk) {
        if constexpr (R3N) apreN[sk] = r3_gdn_fragP_native(pah + sk * 16, lane);
        else               apre[sk]  = fragP(pah + sk * 16);
      }
#endif
    }
#endif
@@ end

