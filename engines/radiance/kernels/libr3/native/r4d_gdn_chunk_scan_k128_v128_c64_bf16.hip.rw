          v8bf bv[SVT];
#pragma unroll
          for (int j = 0; j < SVT; ++j) bv[j] = pvnf(j, sk * 16);
#pragma unroll
          for (int ki = 0; ki < SKT; ++ki) {
#if ABL == 7
            v8bf ak = fragP(rowP(&s.k[0][0], KP, (kt0 + ki) * 16, lane) + sk * 16);
#else
            v8bf ak = fragT(&s.k[0][0], KP, (kt0 + ki) * 16, sk * 16, lane);
#endif
#if ABL != 1
#pragma unroll
            for (int j = 0; j < SVT; ++j)
              St[ki * SVT + j] = mma(ak, bv[j], St[ki * SVT + j]);
#else
            (void)ak;
#endif
          }
#if ABL == 1
#pragma unroll
          for (int j = 0; j < SVT; ++j) (void)bv[j];
#endif
        }
      }
      if constexpr (R3N) {
#pragma unroll
        for (int t = 0; t < NST; ++t) St[t] = r3_acc_native_to_gfx12(St[t]);
      }
@@ end

@@ find 1
#define CS_LAUNCH(SDTC, H0C, HTC)                                                          \
  hipLaunchKernelGGL((r4d_gdn_chunk_scan_kernel<SDTC, H0C, HTC>), grid, blk, 0,            \
      (hipStream_t)stream,                                                                 \
      (const unsigned short*)q, (const unsigned short*)k, (const unsigned short*)v,        \
      (const unsigned short*)A, (const float*)g, (const float*)beta,                       \
      (const cs_state<SDTC>::T*)h0, (unsigned short*)o, (cs_state<SDTC>::T*)ht,            \
      (const int*)cu, (const int*)ssm_state_indices, (indices_stride > 0 ? indices_stride : 1),  \
      st_slot, st_head, H, Hg, scale)
#define CS_PICK(SDTC)                                                                      \
  do { if (h0 && ht) CS_LAUNCH(SDTC, true, true);                                          \
       else if (h0)  CS_LAUNCH(SDTC, true, false);                                         \
       else if (ht)  CS_LAUNCH(SDTC, false, true);                                         \
       else          CS_LAUNCH(SDTC, false, false); } while (0)
  if (state_fp16) CS_PICK(1); else CS_PICK(0);
#undef CS_PICK
#undef CS_LAUNCH
@@ replace
#define CS_LAUNCH(SDTC, H0C, HTC, R3NC)                                                   \
  hipLaunchKernelGGL((r4d_gdn_chunk_scan_kernel<SDTC, H0C, HTC, R3NC>), grid, blk, 0,      \
      (hipStream_t)stream,                                                                 \
      (const unsigned short*)q, (const unsigned short*)k, (const unsigned short*)v,        \
      (const unsigned short*)A, (const float*)g, (const float*)beta,                       \
      (const cs_state<SDTC>::T*)h0, (unsigned short*)o, (cs_state<SDTC>::T*)ht,            \
      (const int*)cu, (const int*)ssm_state_indices, (indices_stride > 0 ? indices_stride : 1), \
      st_slot, st_head, H, Hg, scale)
#define CS_PICK(SDTC, R3NC)                                                                \
  do { if (h0 && ht) CS_LAUNCH(SDTC, true, true, R3NC);                                    \
       else if (h0)  CS_LAUNCH(SDTC, true, false, R3NC);                                   \
       else if (ht)  CS_LAUNCH(SDTC, false, true, R3NC);                                   \
       else          CS_LAUNCH(SDTC, false, false, R3NC); } while (0)
  const char* r3n = std::getenv("R3_GDN_NATIVE");
  const bool use_r3n = !(r3n && *r3n == '0');
  if (state_fp16) { if (use_r3n) CS_PICK(1, true); else CS_PICK(1, false); }
  else            { if (use_r3n) CS_PICK(0, true); else CS_PICK(0, false); }
#undef CS_PICK
#undef CS_LAUNCH
@@ end

