#define pvnf(j, ko) fragP(pvn[j] + (ko))
#define pvnN(j, ko) r3_gdn_fragP_native(pvn[j] + (ko), lane)
#endif
#pragma unroll
      for (int sk = 0; sk < BT / 16; ++sk) {
