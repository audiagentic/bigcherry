# R3_AR_TIMING: deferred HIP-event timing for the fused two-rank all-reduce rows.
# The no-P2P path does not issue D2H/H2D copies: its kernel writes and reads mapped pinned-host
# scratch around the device-side peer handshake. Time the completed kernel sequence without
# turning asynchronous submits into host synchronizations; dump the event durations at AR teardown.
#
@@ find 1
#include <condition_variable>
#include <cstdio>
@@ replace
#include <algorithm>
#include <condition_variable>
#include <cstdio>
@@ end

@@ find 1
    int  host       = 0;
};
@@ replace
    int  host       = 0;
    int  timing     = 0;
};

struct R3ArTimingEvent {
    int rank = -1, wire = 0, bucket = 2, device = -1;
    const char* op = nullptr;
    const char* phase = nullptr;
    unsigned long long payload_bytes = 0;
    hipEvent_t begin = nullptr, end = nullptr;
};

struct R3ArTimingRow {
    int rank = -1, wire = 0, bucket = 2;
    const char* op = nullptr;
    const char* phase = nullptr;
    unsigned long long calls = 0, payload_bytes = 0;
    double total_ms = 0.0;
    std::vector<float> us;
};

std::mutex g_r3_ar_timing_mu;
std::vector<R3ArTimingEvent> g_r3_ar_timing_events;
bool g_r3_ar_timing_dumped = false;

static const char* r3_ar_bucket_name(int b) {
    return b == 0 ? "M1_8" : (b == 1 ? "M512plus" : "M9_511");
}

static void r3_ar_timing_dump() {
    std::vector<R3ArTimingEvent> events;
    {
        std::lock_guard<std::mutex> lk(g_r3_ar_timing_mu);
        if (g_r3_ar_timing_dumped) return;
        g_r3_ar_timing_dumped = true;
        events.swap(g_r3_ar_timing_events);
    }
    if (events.empty()) return;

    std::vector<R3ArTimingRow> rows;
    int old_dev = -1;
    (void)hipGetDevice(&old_dev);
    for (R3ArTimingEvent& e : events) {
        if (e.device >= 0) (void)hipSetDevice(e.device);
        float ms = 0.0f;
        const hipError_t sync = hipEventSynchronize(e.end);
        const hipError_t elapsed = sync == hipSuccess
            ? hipEventElapsedTime(&ms, e.begin, e.end) : sync;
        if (elapsed == hipSuccess) {
            R3ArTimingRow* row = nullptr;
            for (R3ArTimingRow& r : rows) {
                if (r.rank == e.rank && r.wire == e.wire && r.bucket == e.bucket &&
                    !std::strcmp(r.op, e.op) && !std::strcmp(r.phase, e.phase)) {
                    row = &r;
                    break;
                }
            }
            if (!row) {
                rows.push_back(R3ArTimingRow{});
                row = &rows.back();
                row->rank = e.rank; row->wire = e.wire; row->bucket = e.bucket;
                row->op = e.op; row->phase = e.phase;
            }
            ++row->calls;
            row->payload_bytes += e.payload_bytes;
            row->total_ms += ms;
            row->us.push_back(ms * 1000.0f);
        } else {
            std::fprintf(stderr,
                "R3_AR_TIMING rank=%d op=%s wire=%s rows=%s status=event_error code=%d\n",
                e.rank, e.op, e.wire == 6 ? "wht6" : "exact", r3_ar_bucket_name(e.bucket),
                (int)elapsed);
        }
        (void)hipEventDestroy(e.begin);
        (void)hipEventDestroy(e.end);
    }
    if (old_dev >= 0) (void)hipSetDevice(old_dev);

    for (R3ArTimingRow& r : rows) {
        std::sort(r.us.begin(), r.us.end());
        const size_t n = r.us.size();
        const float p50 = r.us[(n - 1) * 50 / 100];
        const float p90 = r.us[(n - 1) * 90 / 100];
        std::fprintf(stderr,
            "R3_AR_TIMING rank=%d op=%s wire=%s rows=%s calls=%llu total_ms=%.3f "
            "phase=%s p50_us=%.1f p90_us=%.1f payload_bytes_per_call=%llu "
            "completion=deferred_hip_event subphases=in_kernel_not_separately_timed\n",
            r.rank, r.op, r.wire == 6 ? "wht6" : "exact", r3_ar_bucket_name(r.bucket),
            r.calls, r.total_ms, r.phase, p50, p90,
            r.calls ? r.payload_bytes / r.calls : 0ULL);
    }
}

struct R3ArTimingScope {
    R3ArTimingEvent e;
    hipStream_t stream = nullptr;
    bool active = false;

    R3ArTimingScope(const ArInst* in, const char* op, const char* phase, int wire,
                    long long M, long long n, RadStream s) {
        if (!in || !in->timing) return;
        e.rank = in->rank;
        e.wire = wire;
        e.bucket = M >= 1 && M <= 8 ? 0 : (M >= 512 ? 1 : 2);
        e.op = op;
        e.phase = phase;
        const unsigned long long elems = (unsigned long long)M * (unsigned long long)n;
        e.payload_bytes = wire == 6 ? elems * 25ULL / 32ULL
                                    : elems * (unsigned long long)in->esize;
        (void)hipGetDevice(&e.device);
        stream = (hipStream_t)(uintptr_t)s;
        if (hipEventCreate(&e.begin) != hipSuccess) return;
        if (hipEventCreate(&e.end) != hipSuccess) {
            (void)hipEventDestroy(e.begin);
            e.begin = nullptr;
            return;
        }
        if (hipEventRecord(e.begin, stream) != hipSuccess) {
            (void)hipEventDestroy(e.begin);
            (void)hipEventDestroy(e.end);
            e.begin = e.end = nullptr;
            return;
        }
        active = true;
    }

    ~R3ArTimingScope() {
        if (!active) return;
        if (hipEventRecord(e.end, stream) != hipSuccess) {
            (void)hipEventDestroy(e.begin);
            (void)hipEventDestroy(e.end);
            return;
        }
        std::lock_guard<std::mutex> lk(g_r3_ar_timing_mu);
        g_r3_ar_timing_events.push_back(e);
        e.begin = e.end = nullptr;
    }
};
@@ end

@@ find 1
    in->rank = rank;
    in->world = world;
    in->host = host;
    in->dtype = dtype_code;
@@ replace
    in->rank = rank;
    in->world = world;
    in->host = host;
    const char* const timing = std::getenv("R3_AR_TIMING");
    in->timing = timing && std::strcmp(timing, "1") == 0;
    in->dtype = dtype_code;
@@ end

@@ find 1
void release(ArInst* in) {
    if (!in) return;
    {
        std::lock_guard<std::mutex> lk(g_cache_mu);
        for (size_t i = 0; i < g_cache.size(); ++i) {
            if (g_cache[i].in != in) continue;
            if (--g_cache[i].refs > 0) return;
            g_cache.erase(g_cache.begin() + (long)i);
            break;
        }
    }
@@ replace
void release(ArInst* in) {
    if (!in) return;
    bool last = false;
    {
        std::lock_guard<std::mutex> lk(g_cache_mu);
        for (size_t i = 0; i < g_cache.size(); ++i) {
            if (g_cache[i].in != in) continue;
            if (--g_cache[i].refs > 0) return;
            g_cache.erase(g_cache.begin() + (long)i);
            last = g_cache.empty();
            break;
        }
    }
    if (last) r3_ar_timing_dump();
@@ end

