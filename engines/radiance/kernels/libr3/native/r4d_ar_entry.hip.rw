# R3_AR_TIMING: wall-clock timing, between stream synchronisations, of the fused two-rank all-reduce rows.
# The no-P2P path does not issue D2H/H2D copies: its kernel writes and reads mapped pinned-host
# scratch around the device-side peer handshake, so one call is one phase from the host side.
#
@@ find 1
#include <condition_variable>
#include <cstdio>
@@ replace
#include <algorithm>
#include <chrono>
#include <condition_variable>
#include <cstdio>
@@ end

@@ find 1
    int  host       = 0;
};
@@ replace
    int  host       = 0;
    int  timing     = 0;
};

/* Wall time of one fused all-reduce call, taken between two stream synchronisations: the engine's HIP layer has no
 * hipEventRecord on its own streams, so a call is timed by draining the stream before it and after it. That makes
 * every timed call synchronous - the run is for the split, not for speed. Reported every kR3ArTimingBatch calls a
 * row (the engine does not release the last instance before it exits, so a report at teardown is never printed). */
struct R3ArTimingRow {
    int rank = -1, wire = 0, bucket = 2;
    const char* op = nullptr;
    const char* phase = nullptr;
    unsigned long long calls = 0, payload_bytes = 0;
    double total_ms = 0.0;
    std::vector<float> us;
};

std::mutex g_r3_ar_timing_mu;
std::vector<R3ArTimingRow> g_r3_ar_timing_rows;
static const size_t kR3ArTimingBatch = 512;

static const char* r3_ar_bucket_name(int b) {
    return b == 0 ? "M1_8" : (b == 1 ? "M512plus" : "M9_511");
}

static void r3_ar_timing_print(R3ArTimingRow& r) {
    if (r.us.empty()) return;
    std::sort(r.us.begin(), r.us.end());
    const size_t n = r.us.size();
    std::fprintf(stderr,
        "R3_AR_TIMING rank=%d op=%s wire=%s rows=%s calls=%llu total_ms=%.3f phase=%s "
        "p50_us=%.1f p90_us=%.1f max_us=%.1f payload_bytes_per_call=%llu timed=sync_before_and_after\n",
        r.rank, r.op, r.wire == 6 ? "wht6" : "exact", r3_ar_bucket_name(r.bucket), r.calls, r.total_ms,
        r.phase, r.us[(n - 1) * 50 / 100], r.us[(n - 1) * 90 / 100], r.us[n - 1],
        r.calls ? r.payload_bytes / r.calls : 0ULL);
    r.us.clear(); r.calls = 0; r.payload_bytes = 0; r.total_ms = 0.0;
}

static void r3_ar_timing_dump() {
    std::lock_guard<std::mutex> lk(g_r3_ar_timing_mu);
    for (R3ArTimingRow& r : g_r3_ar_timing_rows) r3_ar_timing_print(r);
}

struct R3ArTimingScope {
    const ArInst* in = nullptr;
    const char* op = nullptr;
    const char* phase = nullptr;
    int wire = 0, bucket = 2;
    unsigned long long payload = 0;
    hipStream_t stream = nullptr;
    std::chrono::steady_clock::time_point t0;
    bool active = false;

    R3ArTimingScope(const ArInst* i, const char* o, const char* ph, int w, long long M, long long n, RadStream s)
        : in(i), op(o), phase(ph), wire(w) {
        if (!in || !in->timing) return;
        bucket = M >= 1 && M <= 8 ? 0 : (M >= 512 ? 1 : 2);
        const unsigned long long elems = (unsigned long long)M * (unsigned long long)n;
        payload = wire == 6 ? elems * 25ULL / 32ULL : elems * (unsigned long long)in->esize;
        stream = (hipStream_t)(uintptr_t)s;
        if (hipStreamSynchronize(stream) != hipSuccess) return;
        t0 = std::chrono::steady_clock::now();
        active = true;
    }

    ~R3ArTimingScope() {
        if (!active) return;
        if (hipStreamSynchronize(stream) != hipSuccess) return;
        const float us = std::chrono::duration<float, std::micro>(std::chrono::steady_clock::now() - t0).count();
        std::lock_guard<std::mutex> lk(g_r3_ar_timing_mu);
        R3ArTimingRow* row = nullptr;
        for (R3ArTimingRow& r : g_r3_ar_timing_rows)
            if (r.rank == in->rank && r.wire == wire && r.bucket == bucket && r.op == op && r.phase == phase) {
                row = &r;
                break;
            }
        if (!row) {
            g_r3_ar_timing_rows.push_back(R3ArTimingRow{});
            row = &g_r3_ar_timing_rows.back();
            row->rank = in->rank; row->wire = wire; row->bucket = bucket; row->op = op; row->phase = phase;
        }
        ++row->calls;
        row->payload_bytes += payload;
        row->total_ms += us / 1000.0;
        row->us.push_back(us);
        if (row->us.size() >= kR3ArTimingBatch) r3_ar_timing_print(*row);
    }
};
@@ end

@@ find 1
    in->rank = rank;
    in->world = world;
    in->host = host;
    in->dtype = dtype_code;
@@ replace
    in->rank = rank;
    in->world = world;
    in->host = host;
    const char* const timing = std::getenv("R3_AR_TIMING");
    in->timing = timing && std::strcmp(timing, "1") == 0;
    in->dtype = dtype_code;
@@ end

@@ find 1
void release(ArInst* in) {
    if (!in) return;
    {
        std::lock_guard<std::mutex> lk(g_cache_mu);
        for (size_t i = 0; i < g_cache.size(); ++i) {
            if (g_cache[i].in != in) continue;
            if (--g_cache[i].refs > 0) return;
            g_cache.erase(g_cache.begin() + (long)i);
            break;
        }
    }
@@ replace
void release(ArInst* in) {
    if (!in) return;
    bool last = false;
    {
        std::lock_guard<std::mutex> lk(g_cache_mu);
        for (size_t i = 0; i < g_cache.size(); ++i) {
            if (g_cache[i].in != in) continue;
            if (--g_cache[i].refs > 0) return;
            g_cache.erase(g_cache.begin() + (long)i);
            last = g_cache.empty();
            break;
        }
    }
    if (last) r3_ar_timing_dump();
@@ end

