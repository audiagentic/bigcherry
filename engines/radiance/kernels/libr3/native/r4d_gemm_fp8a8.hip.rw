@@ replace
    // libr3 native: one token row is a dot product a weight row, not a 16x16 tile (see the header)
    const bool r3_vec = AW && !I8 && nb == 1u;
    if (r3_vec) {
        float tot = 0.0f, part = 0.0f;
        const uint8_t* const xrow = Bp + (lane >> 4) * 8u;  // token 0 at this lane's half of each fragment's K
        for (uint32_t k = kbeg; k < kend; k += r4d_fp8::kSuperK) {
            r3_u4 wlo = {0u, 0u, 0u, 0u}, whi = {0u, 0u, 0u, 0u};
            if (alive) {
                const uint8_t* const wp =
                    afrag + (size_t)(arow * ksuper + k / r4d_fp8::kSuperK) * r4d_fp8::kTileBytes;
                wlo = *(const r3_u4u*)wp;
                whi = *(const r3_u4u*)(wp + 16);
            }
            const unsigned w[8] = {wlo[0], wlo[1], wlo[2], wlo[3], whi[0], whi[1], whi[2], whi[3]};
#pragma unroll
            for (uint32_t t = 0; t < 4; ++t) {
                const r3_u2u x = *(const r3_u2u*)(xrow + k + t * 16u);
                part = r3_fp8_dot8(w[2 * t], w[2 * t + 1], x[0], x[1], part);
            }
            if ((k + r4d_fp8::kSuperK) % kBlock == 0u || k + r4d_fp8::kSuperK >= kend) {
                const uint32_t kb = k / kBlock;
                const float ws = alive
                    ? bscale(((const uint16_t*)Sa)[(size_t)(wrow0 / kBlock) * sa_ld + kb]) : 0.0f;
                tot = fmaf(part, ws * ((const float*)Sb)[kb], tot);
                part = 0.0f;
            }
        }
        tot *= r3_fp8_f16_unscale;
        const float row = tot + __uint_as_float(r3_from_lane(lane ^ 16u, __float_as_uint(tot)));
#pragma unroll
        for (uint32_t t = 0; t < 8; ++t) {
            const float v = __uint_as_float(r3_from_lane((lane >> 4) * 8u + t, __float_as_uint(row)));
            out[0][0][t] = (lane & 15u) == 0u ? v : 0.0f;
        }
    } else
    for (uint32_t c0 = kbeg; c0 < kend; c0 += FK) {
@@ end
