#pragma unroll
                    for (uint32_t j = 0; j < NT; ++j) raw[i][j] = mma8<I8>(af[i], bf[j], raw[i][j]);
            } else {
                // libr3 native: gfx11 fragments, the accumulator in the gfx11 layout
                r3_v16h naf[MT];
                if (AW) {
                    naf[0] = r3_fp8_frag_reg(af[0], lane);
                } else {
#pragma unroll
                    for (uint32_t i = 0; i < MT; ++i)
                        naf[i] = r3_fp8_frag_bytes(s_a[buf], lds_pitch<FK>(), wm + i * 16, ks, lane);
                }
#pragma unroll
                for (uint32_t j = 0; j < NT; ++j) {
                    const r3_v16h nbf = r3_fp8_frag_f16<FK>(s_b[buf], wn + j * 16, ks, lane);
#pragma unroll
                    for (uint32_t i = 0; i < MT; ++i)
                        raw[i][j] = __builtin_bit_cast(
                            f8v, r3_wmma_f16_native(naf[i], nbf, __builtin_bit_cast(r3_v8f, raw[i][j])));
                }
            }
@@ end

