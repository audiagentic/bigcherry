                            as[i][t] = (Full || r < rows)
                                           ? ws * ((const float*)Sa)[(size_t)r * sa_ld + kb]
@@ replace
                            // libr3 native: the accumulator is in the gfx11 layout here
                            const uint32_t r = m0 + wm + i * 16 + r3_acc_row_native(lane, t);
                            as[i][t] = (Full || r < rows)
                                           ? ws * ((const float*)Sa)[(size_t)r * sa_ld + kb]
@@ end

@@ find 1
        for (uint32_t p = 0; p < kAF; ++p) pf[p] = pfn[p];
        if (kBufs > 1u) buf ^= 1u; else __syncthreads();
    }
@@ replace
        for (uint32_t p = 0; p < kAF; ++p) pf[p] = pfn[p];
        if (kBufs > 1u) buf ^= 1u; else __syncthreads();
    }
    if constexpr (!I8) {  // libr3 native: to the gfx12 layout the epilogue reads, and out of the 2^-16 of the halves
#pragma unroll
        for (uint32_t i = 0; i < MT; ++i)
#pragma unroll
            for (uint32_t j = 0; j < NT; ++j)
                out[i][j] = __builtin_bit_cast(f8v, r3_acc_native_to_gfx12(out[i][j]) * r3_fp8_f16_unscale);
    }
@@ end
