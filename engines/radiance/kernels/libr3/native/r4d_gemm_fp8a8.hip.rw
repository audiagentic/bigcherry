                                      ks * r4d_fp8::kSuperK + (blane >> 4) * 8u, pw[p]);
            else
                r3_fp8_stage_f16<FK>(s_b[buf], rt * 16u + (blane & 15u),
                                      ks * r4d_fp8::kSuperK + (blane >> 4) * 8u, 16u, pw[p]);
@@ end

@@ find 1
