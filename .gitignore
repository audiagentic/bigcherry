# -- Build artifacts --
/build/
!tools/bigcherry/build/
!tools/tests/build/
cmake-build-*/
out/
CMakeCache.txt
CMakeFiles/
*_cache/
package-lock.json

# -- Compiled objects / binaries --
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.pyd
*.dylib
*.exp

# -- C++ intermediate / generated files --
*.gch
*.pch
*.ipp
*.ii
*.spt
*.tlog/
.tmp/
tmp/
/_scratch*/

# -- ROCm / HIP compilation artifacts --
hipBC/
*.hsaco
*.fatbin
*.cubin

# -- Python --
__pycache__/
*.py[cod]
*.class
*.egg-info/
.eggs/
dist/
wheels/
.venv/
env/
!tools/env/
!tools/env/**
venv/

# -- SQLite databases (tuning runs) --
*.sqlite
*.sqlite3
*.db

# -- Tuning / replay data --
tuning/
!tools/bigcherry/tuning/
!tools/tests/tuning/
dispatch-db/

# -- AI tool artifacts --
.audiagentic/
.clinerules/

# -- Build output artifacts --
artifacts/

# -- IDE / Harness config (user-specific, keep locally but not in git) --
.vscode/
.idea/
.claude/*
.codex/
.gemini/
.opencode/
.cline/
.continue/
.mcp.json
.pi/
.roo/
COPILOT.md
GEMINI.md
QWEN.md
*.swp
*.swo
*~

# -- OS --
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Icon?

# -- Logs --
*.log

# -- Cloned sub-repos / upstream snapshots --
# The canonical upstream checkout lives under vendor/ and is materialized from
# the configured pin. Do not commit copied upstream source into lab directories.
vendor/
tools/lab/**/vendor-*/
prodtest_loop.sh

# -- Shared project procedure (re-included from the .claude/* rule above) --
# Skills are not user-specific harness config: they encode how to run this
# project's tooling correctly, and exist because getting it wrong produced
# retracted results. They must be reviewable, shared, and versioned with the
# code whose behaviour they describe. Everything else under .claude/ stays
# local, which is why the rule above is .claude/* rather than .claude/.
!.claude/skills/

# tools/lab/bump-validation's own --output default and similar ad hoc
# working directories -- never committed, per-run scratch only.
/work/
.nodeterm/

# Host-specific settings are never committed: copy config/environment.example.toml
# to config/environment.local.toml (or point BIGCHERRY_ENVIRONMENT at a file).
/config/environment.local.toml

# FUSE mount artifacts (/mnt/vault): open-but-replaced files; never tracked, must not mark the tree dirty
.fuse_hidden*
.rocprofv3/

# Lab run output is transient; compact evidence belongs under docs/evidence/.
/tools/lab/native-vs-patched/runs/
